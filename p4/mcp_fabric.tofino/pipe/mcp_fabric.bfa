        0..7: random(md.role(10..15), md.hop, md.dst_leaf) ^ md.role(0..7)
        8..9: random(md.role(10..15), md.hop, md.dst_leaf) ^ md.role(8..9)
        11..18: random(md.role(10..15), md.hop, md.dst_leaf) ^ md.role(0..7)
        19: random(md.role(10..15), md.hop, md.dst_leaf) ^ md.role(8)
