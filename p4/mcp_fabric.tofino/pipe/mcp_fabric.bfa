parser ingress:
  start: $init_match
  init_zero: [ W2, W3, H15, B3, H8, H4, H5, H6, H9, B2, H13, H3, B4, B1, B0, H1 ]
  bitwise_or: [ H3 ]
  hdr_len_adj: 16
  states:
    $init_match:
      *:
        load: { half : 28..29 }
        buf_req: 30
        next: $entry_point.start
    $entry_point.start:
      match: [ half ]
      0x88f0:
        0..1: H13  # bit[7..15] -> H13 bit[8..0]: ingress::ig_intr_md.ingress_port
        16..17: TH13  # ingress::hdr.ethernet.dst_addr[47:32].32-47
        18..21: TW9  # ingress::hdr.ethernet.dst_addr[31:0].0-31
        22..23: TH12  # ingress::hdr.ethernet.src_addr[47:32].32-47
        24..27: TW8  # ingress::hdr.ethernet.src_addr[31:0].0-31
        28..29: H14  # ingress::hdr.ethernet.ether_type
        H3: 1  # value 1 -> H3 bit[0]: ingress::hdr.ethernet.$valid
        shift: 30
        buf_req: 30
        next: parse_fabric
      0x0800:
        0..1: H13  # bit[7..15] -> H13 bit[8..0]: ingress::ig_intr_md.ingress_port
        16..17: TH13  # ingress::hdr.ethernet.dst_addr[47:32].32-47
        18..21: TW9  # ingress::hdr.ethernet.dst_addr[31:0].0-31
        22..23: TH12  # ingress::hdr.ethernet.src_addr[47:32].32-47
        24..27: TW8  # ingress::hdr.ethernet.src_addr[31:0].0-31
        28..29: H14  # ingress::hdr.ethernet.ether_type
        H3: 1  # value 1 -> H3 bit[0]: ingress::hdr.ethernet.$valid
        shift: 30
        buf_req: 30
        next: $entry_point.start.$oob_stall_0
      0x****:
        0..1: H13  # bit[7..15] -> H13 bit[8..0]: ingress::ig_intr_md.ingress_port
        16..17: TH13  # ingress::hdr.ethernet.dst_addr[47:32].32-47
        18..21: TW9  # ingress::hdr.ethernet.dst_addr[31:0].0-31
        22..23: TH12  # ingress::hdr.ethernet.src_addr[47:32].32-47
        24..27: TW8  # ingress::hdr.ethernet.src_addr[31:0].0-31
        28..29: H14  # ingress::hdr.ethernet.ether_type
        H3: 1  # value 1 -> H3 bit[0]: ingress::hdr.ethernet.$valid
        shift: 30
        buf_req: 30
        next: end
    parse_fabric:
      *:
        0..1: H12
            # - bit[0..7] -> H12 bit[15..8]: ingress::hdr.fabric.vsw_id
            # - bit[8..15] -> H12 bit[7..0]: ingress::hdr.fabric.hop
        0..1: H15  # bit[8..15] -> H15 bit[7..0]: ingress::md.hop[7:0].0-7
        1..2: H8  # bit[16..23] -> H8 bit[7..0]: ingress::md.spray_idx[7:0].0-7
        2..3: H7
            # - bit[16..23] -> H7 bit[15..8]: ingress::hdr.fabric.spray
            # - bit[24..31] -> H7 bit[7..0]: ingress::hdr.fabric.loops
        H3: 2  # value 1 -> H3 bit[1]: ingress::hdr.fabric.$valid
        load: { byte1 : 5 }
        shift: 4
        buf_req: 6
        next: parse_fabric.$split_0
    parse_fabric.$split_0:
      match: [ byte1 ]
      0x01:
        0..1: H2
            # - bit[0..7] -> H2 bit[15..8]: ingress::hdr.fabric.flags
            # - bit[8..15] -> H2 bit[7..0]: ingress::hdr.fabric.nxt
        2..5: TW6
            # - bit[0..7] -> TW6 bit[31..24]: ingress::hdr.csig.worst_hop
            # - bit[8..15] -> TW6 bit[23..16]: ingress::hdr.csig.worst_vlink
            # - bit[16..31] -> TW6 bit[15..0]: ingress::hdr.csig.worst_qdepth
        6..9: TW10  # ingress::hdr.csig.worst_tdelta
        10..11: TH11  # ingress::hdr.csig.path_id
        12..13: TH10  # ingress::hdr.csig.epoch
        H3: 4  # value 1 -> H3 bit[2]: ingress::hdr.csig.$valid
        load: { byte1 : 23 }
        shift: 14
        buf_req: 24
        next: parse_ipv4
      0x**:
        0..1: H2
            # - bit[0..7] -> H2 bit[15..8]: ingress::hdr.fabric.flags
            # - bit[8..15] -> H2 bit[7..0]: ingress::hdr.fabric.nxt
        load: { byte1 : 11 }
        shift: 2
        buf_req: 12
        next: parse_ipv4
    parse_ipv4:
      match: [ byte1 ]
      0x11:
        0..3: TW4
            # - bit[0..3] -> TW4 bit[31..28]: ingress::hdr.ipv4.version
            # - bit[4..7] -> TW4 bit[27..24]: ingress::hdr.ipv4.ihl
            # - bit[8..15] -> TW4 bit[23..16]: ingress::hdr.ipv4.diffserv
            # - bit[16..31] -> TW4 bit[15..0]: ingress::hdr.ipv4.total_len
        4..5: TH7  # ingress::hdr.ipv4.identification
        6..7: TH6
            # - bit[48..50] -> TH6 bit[15..13]: ingress::hdr.ipv4.flags
            # - bit[51..63] -> TH6 bit[12..0]: ingress::hdr.ipv4.frag_offset
        8..11: TW7
            # - bit[64..71] -> TW7 bit[31..24]: ingress::hdr.ipv4.ttl
            # - bit[72..79] -> TW7 bit[23..16]: ingress::hdr.ipv4.protocol
            # - bit[80..95] -> TW7 bit[15..0]: ingress::hdr.ipv4.hdr_checksum
        12..15: W1  # ingress::hdr.ipv4.src_addr
        16..19: W0  # ingress::hdr.ipv4.dst_addr
        H3: 8  # value 1 -> H3 bit[3]: ingress::hdr.ipv4.$valid
        load: { half : 22..23 }
        shift: 20
        buf_req: 24
        next: parse_udp
      0x**:
        0..3: TW4
            # - bit[0..3] -> TW4 bit[31..28]: ingress::hdr.ipv4.version
            # - bit[4..7] -> TW4 bit[27..24]: ingress::hdr.ipv4.ihl
            # - bit[8..15] -> TW4 bit[23..16]: ingress::hdr.ipv4.diffserv
            # - bit[16..31] -> TW4 bit[15..0]: ingress::hdr.ipv4.total_len
        4..5: TH7  # ingress::hdr.ipv4.identification
        6..7: TH6
            # - bit[48..50] -> TH6 bit[15..13]: ingress::hdr.ipv4.flags
            # - bit[51..63] -> TH6 bit[12..0]: ingress::hdr.ipv4.frag_offset
        8..11: TW7
            # - bit[64..71] -> TW7 bit[31..24]: ingress::hdr.ipv4.ttl
            # - bit[72..79] -> TW7 bit[23..16]: ingress::hdr.ipv4.protocol
            # - bit[80..95] -> TW7 bit[15..0]: ingress::hdr.ipv4.hdr_checksum
        12..15: W1  # ingress::hdr.ipv4.src_addr
        16..19: W0  # ingress::hdr.ipv4.dst_addr
        H3: 8  # value 1 -> H3 bit[3]: ingress::hdr.ipv4.$valid
        shift: 20
        buf_req: 20
        next: end
    parse_udp:
      match: [ half ]
      0x12b7:
        0..1: H11  # ingress::hdr.udp.src_port
        2: TB7  # ingress::hdr.udp.dst_port[15:8].8-15
        3: TB6  # ingress::hdr.udp.dst_port[7:0].0-7
        4: TB5  # ingress::hdr.udp.len[15:8].8-15
        5: TB4  # ingress::hdr.udp.len[7:0].0-7
        6..7: H10  # ingress::hdr.udp.checksum
        H3: 16  # value 1 -> H3 bit[4]: ingress::hdr.udp.$valid
        shift: 8
        buf_req: 8
        next: parse_bth
      0xe5e5:
        0..1: H11  # ingress::hdr.udp.src_port
        2: TB7  # ingress::hdr.udp.dst_port[15:8].8-15
        3: TB6  # ingress::hdr.udp.dst_port[7:0].0-7
        4: TB5  # ingress::hdr.udp.len[15:8].8-15
        5: TB4  # ingress::hdr.udp.len[7:0].0-7
        6..7: H10  # ingress::hdr.udp.checksum
        H3: 16  # value 1 -> H3 bit[4]: ingress::hdr.udp.$valid
        shift: 8
        buf_req: 8
        next: parse_evid
      0x****:
        0..1: H11  # ingress::hdr.udp.src_port
        2: TB7  # ingress::hdr.udp.dst_port[15:8].8-15
        3: TB6  # ingress::hdr.udp.dst_port[7:0].0-7
        4: TB5  # ingress::hdr.udp.len[15:8].8-15
        5: TB4  # ingress::hdr.udp.len[7:0].0-7
        6..7: H10  # ingress::hdr.udp.checksum
        H3: 16  # value 1 -> H3 bit[4]: ingress::hdr.udp.$valid
        shift: 8
        buf_req: 8
        next: end
    parse_bth:
      *:
        0..3: TW11  # ingress::hdr.bth.w0
        4..5: TH9  # ingress::hdr.bth.w1[31:16].16-31
        6..7: TH8  # ingress::hdr.bth.w1[15:0].0-15
        8..11: TW5  # ingress::hdr.bth.w2
        H3: 32  # value 1 -> H3 bit[5]: ingress::hdr.bth.$valid
        shift: 12
        buf_req: 12
        next: end
    parse_evid:
      *:
        0..3: TW5
            # - bit[0..7] -> TW5 bit[31..24]: ingress::hdr.evid.magic
            # - bit[8..15] -> TW5 bit[23..16]: ingress::hdr.evid.path_id
            # - bit[16..23] -> TW5 bit[15..8]: ingress::hdr.evid.rtt_q
            # - bit[24..31] -> TW5 bit[7..0]: ingress::hdr.evid.loss_q
        4..5: TH9
            # - bit[32..39] -> TH9 bit[15..8]: ingress::hdr.evid.ecn_q
            # - bit[40..47] -> TH9 bit[7..0]: ingress::hdr.evid.flags
        6..7: TH8  # ingress::hdr.evid.seq
        H3: 64  # value 1 -> H3 bit[6]: ingress::hdr.evid.$valid
        shift: 8
        buf_req: 8
        next: end
    $entry_point.start.$oob_stall_0:
      *:
        load: { byte1 : 9 }
        buf_req: 10
        next: parse_ipv4
deparser ingress:
  dictionary:
    TH13: H3(0)  # ingress::hdr.ethernet.dst_addr.32-47 if ingress::hdr.ethernet.$valid
    TW9: H3(0)  # ingress::hdr.ethernet.dst_addr.0-31 if ingress::hdr.ethernet.$valid
    TH12: H3(0)  # ingress::hdr.ethernet.src_addr.32-47 if ingress::hdr.ethernet.$valid
    TW8: H3(0)  # ingress::hdr.ethernet.src_addr.0-31 if ingress::hdr.ethernet.$valid
    H14: H3(0)  # ingress::hdr.ethernet.ether_type if ingress::hdr.ethernet.$valid
    H12: H3(1)
        # - bit[15..8]: ingress::hdr.fabric.vsw_id if ingress::hdr.fabric.$valid
        # - bit[7..0]: ingress::hdr.fabric.hop if ingress::hdr.fabric.$valid
    H7: H3(1)
        # - bit[15..8]: ingress::hdr.fabric.spray if ingress::hdr.fabric.$valid
        # - bit[7..0]: ingress::hdr.fabric.loops if ingress::hdr.fabric.$valid
    H2: H3(1)
        # - bit[15..8]: ingress::hdr.fabric.flags if ingress::hdr.fabric.$valid
        # - bit[7..0]: ingress::hdr.fabric.nxt if ingress::hdr.fabric.$valid
    TW6: H3(2)
        # - bit[31..24]: ingress::hdr.csig.worst_hop if ingress::hdr.csig.$valid
        # - bit[23..16]: ingress::hdr.csig.worst_vlink if ingress::hdr.csig.$valid
        # - bit[15..0]: ingress::hdr.csig.worst_qdepth if ingress::hdr.csig.$valid
    TW10: H3(2)  # ingress::hdr.csig.worst_tdelta if ingress::hdr.csig.$valid
    TH11: H3(2)  # ingress::hdr.csig.path_id if ingress::hdr.csig.$valid
    TH10: H3(2)  # ingress::hdr.csig.epoch if ingress::hdr.csig.$valid
    TW4: H3(3)
        # - bit[31..28]: ingress::hdr.ipv4.version if ingress::hdr.ipv4.$valid
        # - bit[27..24]: ingress::hdr.ipv4.ihl if ingress::hdr.ipv4.$valid
        # - bit[23..16]: ingress::hdr.ipv4.diffserv if ingress::hdr.ipv4.$valid
        # - bit[15..0]: ingress::hdr.ipv4.total_len if ingress::hdr.ipv4.$valid
    TH7: H3(3)  # ingress::hdr.ipv4.identification if ingress::hdr.ipv4.$valid
    TH6: H3(3)
        # - bit[15..13]: ingress::hdr.ipv4.flags if ingress::hdr.ipv4.$valid
        # - bit[12..0]: ingress::hdr.ipv4.frag_offset if ingress::hdr.ipv4.$valid
    TW7: H3(3)
        # - bit[31..24]: ingress::hdr.ipv4.ttl if ingress::hdr.ipv4.$valid
        # - bit[23..16]: ingress::hdr.ipv4.protocol if ingress::hdr.ipv4.$valid
        # - bit[15..0]: ingress::hdr.ipv4.hdr_checksum if ingress::hdr.ipv4.$valid
    W1: H3(3)  # ingress::hdr.ipv4.src_addr if ingress::hdr.ipv4.$valid
    W0: H3(3)  # ingress::hdr.ipv4.dst_addr if ingress::hdr.ipv4.$valid
    H11: H3(4)  # ingress::hdr.udp.src_port if ingress::hdr.udp.$valid
    TB7: H3(4)  # ingress::hdr.udp.dst_port.8-15 if ingress::hdr.udp.$valid
    TB6: H3(4)  # ingress::hdr.udp.dst_port.0-7 if ingress::hdr.udp.$valid
    TB5: H3(4)  # ingress::hdr.udp.len.8-15 if ingress::hdr.udp.$valid
    TB4: H3(4)  # ingress::hdr.udp.len.0-7 if ingress::hdr.udp.$valid
    H10: H3(4)  # ingress::hdr.udp.checksum if ingress::hdr.udp.$valid
    TW11: H3(5)  # ingress::hdr.bth.w0 if ingress::hdr.bth.$valid
    TH9: H3(5)  # ingress::hdr.bth.w1.16-31 if ingress::hdr.bth.$valid
    TH8: H3(5)  # ingress::hdr.bth.w1.0-15 if ingress::hdr.bth.$valid
    TW5: H3(5)  # ingress::hdr.bth.w2 if ingress::hdr.bth.$valid
    TW5: H3(6)
        # - bit[31..24]: ingress::hdr.evid.magic if ingress::hdr.evid.$valid
        # - bit[23..16]: ingress::hdr.evid.path_id if ingress::hdr.evid.$valid
        # - bit[15..8]: ingress::hdr.evid.rtt_q if ingress::hdr.evid.$valid
        # - bit[7..0]: ingress::hdr.evid.loss_q if ingress::hdr.evid.$valid
    TH9: H3(6)
        # - bit[15..8]: ingress::hdr.evid.ecn_q if ingress::hdr.evid.$valid
        # - bit[7..0]: ingress::hdr.evid.flags if ingress::hdr.evid.$valid
    TH8: H3(6)  # ingress::hdr.evid.seq if ingress::hdr.evid.$valid
  egress_unicast_port: H0(0..8)  # bit[8..0]: ingress::ig_intr_md_for_tm.ucast_egress_port
  qid: B1(0..4)  # bit[4..0]: ingress::ig_intr_md_for_tm.qid
  drop_ctl: B1(5..7)  # bit[7..5]: ingress::ig_intr_md_for_dprsr.drop_ctl
  mirror:
    select: B0(0..2)  # bit[2..0]: ingress::ig_intr_md_for_dprsr.mirror_type
    0:
      - H1(0..9)  # bit[9..0]: ingress::$tmp2
parser egress:
  start: $entry_point.start
  init_zero: [ B17, B16 ]
  bitwise_or: [ B16, B17 ]
  hdr_len_adj: 27
  meta_opt: 8191
  states:
    $entry_point.start:
      *:
        counter:
          imm: 24
        0..1: H16  # bit[7..15] -> H16 bit[8..0]: egress::eg_intr_md.egress_port
        27..28: TH23  # egress::hdr.ethernet.dst_addr[47:32].32-47
        29..30: TH1  # egress::hdr.ethernet.dst_addr[31:16].16-31
        B17: 1  # value 1 -> B17 bit[0]: egress::hdr.ethernet.$valid
        intr_md: 9
        shift: 31
        buf_req: 31
        next: $entry_point.start.$oob_stall_1
    $entry_point.start.$oob_stall_1:
      *:
        load: { half : 8..9 }
        buf_req: 10
        next: $entry_point.start.$split_0
    $entry_point.start.$split_0:
      match: [ half ]
      0x88f0:
        counter: dec 6
        0..1: TH0  # egress::hdr.ethernet.dst_addr[15:0].0-15
        2..3: TH22  # egress::hdr.ethernet.src_addr[47:32].32-47
        4..7: TW3  # egress::hdr.ethernet.src_addr[31:0].0-31
        8..9: TH21  # egress::hdr.ethernet.ether_type
        10..11: TH20
            # - bit[0..7] -> TH20 bit[15..8]: egress::hdr.fabric.vsw_id
            # - bit[8..15] -> TH20 bit[7..0]: egress::hdr.fabric.hop
        12..15: TW0
            # - bit[16..23] -> TW0 bit[31..24]: egress::hdr.fabric.spray
            # - bit[24..31] -> TW0 bit[23..16]: egress::hdr.fabric.loops
            # - bit[32..39] -> TW0 bit[15..8]: egress::hdr.fabric.flags
            # - bit[40..47] -> TW0 bit[7..0]: egress::hdr.fabric.nxt
        B17: 2  # value 1 -> B17 bit[1]: egress::hdr.fabric.$valid
        load: { byte1 : 15 }
        shift: 16
        buf_req: 16
        next: parse_fabric
      0x****:
        0..1: TH0  # egress::hdr.ethernet.dst_addr[15:0].0-15
        2..3: TH22  # egress::hdr.ethernet.src_addr[47:32].32-47
        4..7: TW3  # egress::hdr.ethernet.src_addr[31:0].0-31
        8..9: TH21  # egress::hdr.ethernet.ether_type
        shift: 10
        buf_req: 10
        next: min_parse_depth_accept_initial
    parse_fabric:
      match: [ byte1 ]
      0x01:
        counter: dec 12
        0..3: TW1
            # - bit[0..7] -> TW1 bit[31..24]: egress::hdr.csig.worst_hop
            # - bit[8..15] -> TW1 bit[23..16]: egress::hdr.csig.worst_vlink
            # - bit[16..31] -> TW1 bit[15..0]: egress::hdr.csig.worst_qdepth
        4..5: TH3  # egress::hdr.csig.worst_tdelta[31:16].16-31
        6..7: TH2  # egress::hdr.csig.worst_tdelta[15:0].0-15
        8..11: TW2
            # - bit[64..79] -> TW2 bit[31..16]: egress::hdr.csig.path_id
            # - bit[80..95] -> TW2 bit[15..0]: egress::hdr.csig.epoch
        B17: 4  # value 1 -> B17 bit[2]: egress::hdr.csig.$valid
        shift: 12
        buf_req: 12
        next: min_parse_depth_accept_initial
      0x**:
        buf_req: 0
        next: min_parse_depth_accept_initial
    min_parse_depth_accept_initial:
      match: [ ctr_neg, ctr_zero ]
      0x0:
        counter: dec 11
        0: TB0  # egress::hdr.min_parse_depth_padding_0[0].packet_payload[87:80].80-87
        1: TB12  # egress::hdr.min_parse_depth_padding_0[0].packet_payload[79:72].72-79
        2: TB3  # egress::hdr.min_parse_depth_padding_0[0].packet_payload[71:64].64-71
        3..6: TW12  # egress::hdr.min_parse_depth_padding_0[0].packet_payload[63:32].32-63
        7..8: TH5  # egress::hdr.min_parse_depth_padding_0[0].packet_payload[31:16].16-31
        9..10: TH4  # egress::hdr.min_parse_depth_padding_0[0].packet_payload[15:0].0-15
        B16: 4  # value 4 -> B16 bit[2..0]: egress::hdr.min_parse_depth_padding_0.$stkvalid
        shift: 11
        buf_req: 11
        next: min_parse_depth_accept_loop.$split_0
      0b**:
        buf_req: 0
        next: end
    min_parse_depth_accept_loop.$split_0:
      match: [ ctr_neg, ctr_zero ]
      0x0:
        counter: dec 11
        0: TB1  # egress::hdr.min_parse_depth_padding_0[1].packet_payload[87:80].80-87
        1: TB14  # egress::hdr.min_parse_depth_padding_0[1].packet_payload[79:72].72-79
        2: TB13  # egress::hdr.min_parse_depth_padding_0[1].packet_payload[71:64].64-71
        3..6: TW14  # egress::hdr.min_parse_depth_padding_0[1].packet_payload[63:32].32-63
        7..10: TW13  # egress::hdr.min_parse_depth_padding_0[1].packet_payload[31:0].0-31
        B16: 2  # value 2 -> B16 bit[2..0]: egress::hdr.min_parse_depth_padding_0.$stkvalid
        shift: 11
        buf_req: 11
        next: min_parse_depth_accept_loop.$it1.$split_0
      0b**:
        buf_req: 0
        next: end
    min_parse_depth_accept_loop.$it1.$split_0:
      match: [ ctr_neg, ctr_zero ]
      0x0:
        counter: dec 11
        0: TB2  # egress::hdr.min_parse_depth_padding_0[2].packet_payload[87:80].80-87
        1..2: TH24  # egress::hdr.min_parse_depth_padding_0[2].packet_payload[79:64].64-79
        3..4: TH19  # egress::hdr.min_parse_depth_padding_0[2].packet_payload[63:48].48-63
        5..6: TH18  # egress::hdr.min_parse_depth_padding_0[2].packet_payload[47:32].32-47
        7..10: TW15  # egress::hdr.min_parse_depth_padding_0[2].packet_payload[31:0].0-31
        B16: 1  # value 1 -> B16 bit[2..0]: egress::hdr.min_parse_depth_padding_0.$stkvalid
        shift: 11
        buf_req: 11
        next: end
      0b**:
        buf_req: 0
        next: end
