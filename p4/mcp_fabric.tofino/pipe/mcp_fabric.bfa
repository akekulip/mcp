stage 0 ingress:
  phase0_match IgParser.$PORT_METADATA:
    p4:
      name: IgParser.$PORT_METADATA
      size: 288
      preferred_match_type: exact
      match_type: exact
    size: 288
    p4_param_order:
      ig_intr_md.ingress_port: { type: exact, size: 9 }
    format: {ig_intr_md: 0..63}
    constant_value: 0
    actions:
      set_port_metadata:
      - handle: 0x20000000
      - p4_param_order: { ig_intr_md: 64 } 
  exact_match tbl_port_role_0 0:
    p4: { name: Ingress.tbl_port_role, size: 64 }
    p4_param_order: 
      ig_intr_md.ingress_port: { type: exact, size: 9, full_size: 9 }
    row: 7
    bus: 0
    column: 2
    stash: 
      row: [ 7 ]
      col: [ 2 ]
      unit: [ 0 ]
    ways:
      - { group: 0, index: 0..9, select: 40..51 & 0x0, rams: [[7, 2]] }
    input_xbar:
      exact group 0: { 0: ig_intr_md.ingress_port }
      hash 0:
        0..7: ig_intr_md.ingress_port(0..7)
        8: ig_intr_md.ingress_port(8)
      hash group 0:
        table: [0]
        seed: 0x0
    format: { immediate(0): 0..31, version(0): 112..115 }
    match_group_map: [ [ 0 ] ]
    hit: [  tbl_mcp_fabric540 ]
    miss:  tbl_mcp_fabric540
    action_bus: { 96..99 : immediate(0..31) }
    instruction: tbl_port_role_0($DEFAULT, $DEFAULT)
    actions:
      Ingress.set_role(0, 1):
      - p4_param_order: { role: 16, src_leaf: 16 }
      - hit_allowed: { allowed: true }
      - default_action: { allowed: true, is_constant: true }
      - handle: 0x20000001
      - next_table: 0
      - { $data0: immediate(0..31), role_1: $data0(0..15), role: role_1, src_leaf_1: $data0(16..31), src_leaf: src_leaf_1 }
      - set W2(0..31), $data0
    default_action: Ingress.set_role
    default_action_parameters:
      role: "0x0"
      src_leaf: "0x0"
stage 1 ingress:
  dependency: match
