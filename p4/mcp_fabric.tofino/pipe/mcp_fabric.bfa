    - { name : eg_intr_md.deq_qdepth, live_start : parser, live_end : 0, mutually_exclusive_with: [  ] }
    H16:
    - { name : eg_intr_md.deq_qdepth, live_start : parser, live_end : 0, mutually_exclusive_with: [  ] }
    H17:
    - { name : hdr.csig.worst_qdepth, live_start : parser, live_end : deparser, mutually_exclusive_with: [  ] }
    H18:
    - { name : md.this_q, live_start : 1, live_end : 2, mutually_exclusive_with: [  ] }
    H19:
    - { name : md.diff, live_start : 2, live_end : 2, mutually_exclusive_with: [  ] }
    H20:
    - { name : eg_intr_md.egress_port, live_start : parser, live_end : deparser, mutually_exclusive_with: [  ] }
    H21:
    - { name : hdr.csig.worst_vlink, live_start : parser, live_end : deparser, mutually_exclusive_with: [  ] }
    H22:
    - { name : md.vlink, live_start : 1, live_end : 2, mutually_exclusive_with: [  ] }
    W16:
    - { name : eg_intr_md.deq_timedelta, live_start : parser, live_end : 0, mutually_exclusive_with: [  ] }
    W17:
    - { name : hdr.csig.worst_tdelta, live_start : parser, live_end : deparser, mutually_exclusive_with: [  ] }
    W18:
    - { name : md.tdelta, live_start : 1, live_end : 2, mutually_exclusive_with: [  ] }
    W19:
    - { name : eg_intr_md.egress_qid, live_start : parser, live_end : 0, mutually_exclusive_with: [  ] }
parser ingress:
  start: $entry_point.start
  init_zero: [ W4, H40, H41, W6, H4, B4, H9, H5, H6, H7, H10, W5, W7, B3, H12, B5, H1, B1, B0, H2 ]
  bitwise_or: [ H4 ]
  hdr_len_adj: 16
  states:
    $entry_point.start:
      *:
        0..1: H12  # bit[7..15] -> H12 bit[8..0]: ingress::ig_intr_md.ingress_port
        16..17: TH13  # ingress::hdr.ethernet.dst_addr[47:32].32-47
        18..19: TH11  # ingress::hdr.ethernet.dst_addr[31:16].16-31
        20..21: TH10  # ingress::hdr.ethernet.dst_addr[15:0].0-15
        H4: 1  # value 1 -> H4 bit[0]: ingress::hdr.ethernet.$valid
        load: { half : 28..29 }
        shift: 22
        buf_req: 30
        next: $entry_point.start.$split_0
    $entry_point.start.$split_0:
      match: [ half ]
      0x88f0:
        0..1: TH12  # ingress::hdr.ethernet.src_addr[47:32].32-47
        2..3: TH9  # ingress::hdr.ethernet.src_addr[31:16].16-31
        4..5: TH8  # ingress::hdr.ethernet.src_addr[15:0].0-15
        6..7: H35  # ingress::hdr.ethernet.ether_type
        shift: 8
        buf_req: 8
        next: parse_fabric
      0x0800:
        0..1: TH12  # ingress::hdr.ethernet.src_addr[47:32].32-47
        2..3: TH9  # ingress::hdr.ethernet.src_addr[31:16].16-31
        4..5: TH8  # ingress::hdr.ethernet.src_addr[15:0].0-15
        6..7: H35  # ingress::hdr.ethernet.ether_type
        shift: 8
        buf_req: 8
        next: parse_ipv4
      0x****:
        0..1: TH12  # ingress::hdr.ethernet.src_addr[47:32].32-47
        2..3: TH9  # ingress::hdr.ethernet.src_addr[31:16].16-31
        4..5: TH8  # ingress::hdr.ethernet.src_addr[15:0].0-15
        6..7: H35  # ingress::hdr.ethernet.ether_type
        shift: 8
        buf_req: 8
        next: end
    parse_fabric:
      *:
        0..1: H3
            # - bit[0..7] -> H3 bit[15..8]: ingress::hdr.fabric.vsw_id
            # - bit[8..15] -> H3 bit[7..0]: ingress::hdr.fabric.hop
        0..3: W4  # bit[8..15] -> W4 bit[23..16]: ingress::md.hop[7:0].0-7
        1..2: H9  # bit[16..23] -> H9 bit[7..0]: ingress::md.spray_idx[7:0].0-7
        2..3: H8
            # - bit[16..23] -> H8 bit[15..8]: ingress::hdr.fabric.spray
            # - bit[24..31] -> H8 bit[7..0]: ingress::hdr.fabric.loops
        4..5: H11
            # - bit[32..39] -> H11 bit[15..8]: ingress::hdr.fabric.flags
            # - bit[40..47] -> H11 bit[7..0]: ingress::hdr.fabric.nxt
        H4: 2  # value 1 -> H4 bit[1]: ingress::hdr.fabric.$valid
        load: { byte1 : 5 }
        shift: 5
        buf_req: 6
        next: parse_fabric.$split_0
    parse_fabric.$split_0:
      match: [ byte1 ]
      0x01:
        0..1: H41  # bit[8..15] -> H41 bit[7..0]: ingress::md.attn_idx[15:8].8-15
        1..2: H33  # ingress::hdr.fabric.path_id
        1..2: H40  # bit[16..23] -> H40 bit[7..0]: ingress::md.attn_idx[7:0].0-7
        shift: 3
        buf_req: 3
        next: parse_csig
      0x**:
        0..1: H41  # bit[8..15] -> H41 bit[7..0]: ingress::md.attn_idx[15:8].8-15
        1..2: H33  # ingress::hdr.fabric.path_id
        1..2: H40  # bit[16..23] -> H40 bit[7..0]: ingress::md.attn_idx[7:0].0-7
        shift: 3
        buf_req: 3
        next: parse_ipv4
    parse_csig:
      *:
        0..1: H36  # ingress::hdr.csig.worst_hop
        2..5: W0
            # - bit[16..31] -> W0 bit[31..16]: ingress::hdr.csig.worst_vlink
            # - bit[32..47] -> W0 bit[15..0]: ingress::hdr.csig.worst_qdepth
        6..9: W1  # ingress::hdr.csig.worst_tdelta
        10..11: H34  # ingress::hdr.csig.path_id
        12..13: H13  # ingress::hdr.csig.epoch
        H4: 4  # value 1 -> H4 bit[2]: ingress::hdr.csig.$valid
        shift: 14
        buf_req: 14
        next: parse_ipv4
    parse_ipv4:
      *:
        0..3: TW4
            # - bit[0..3] -> TW4 bit[31..28]: ingress::hdr.ipv4.version
            # - bit[4..7] -> TW4 bit[27..24]: ingress::hdr.ipv4.ihl
            # - bit[8..15] -> TW4 bit[23..16]: ingress::hdr.ipv4.diffserv
            # - bit[16..31] -> TW4 bit[15..0]: ingress::hdr.ipv4.total_len
        4..7: TW7
