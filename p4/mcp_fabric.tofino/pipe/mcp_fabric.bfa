    - { name : hdr.ethernet.$valid, live_start : parser, live_end : deparser, mutually_exclusive_with: [  ] }
    - { name : hdr.fabric.$valid, live_start : parser, live_end : deparser, mutually_exclusive_with: [  ] }
    - { name : hdr.csig.$valid, live_start : parser, live_end : deparser, mutually_exclusive_with: [  ] }
    - { name : hdr.ipv4.$valid, live_start : parser, live_end : deparser, mutually_exclusive_with: [  ] }
    - { name : hdr.udp.$valid, live_start : parser, live_end : deparser, mutually_exclusive_with: [  ] }
    - { name : hdr.bth.$valid, live_start : parser, live_end : deparser, mutually_exclusive_with: [  ] }
    - { name : hdr.evid.$valid, live_start : parser, live_end : deparser, mutually_exclusive_with: [  ] }
    H4:
    - { name : md.spray_rand, live_start : 2, live_end : 3, mutually_exclusive_with: [  ] }
    H5:
    - { name : md.spray_hash, live_start : 2, live_end : 3, mutually_exclusive_with: [  ] }
    H6:
    - { name : md.spray_rr, live_start : 2, live_end : 3, mutually_exclusive_with: [  ] }
    H7:
    - { name : hdr.fabric.spray, live_start : parser, live_end : deparser, mutually_exclusive_with: [  ] }
    - { name : hdr.fabric.loops, live_start : parser, live_end : deparser, mutually_exclusive_with: [  ] }
    H8:
    - { name : md.spray_idx, live_start : parser, live_end : 7, mutually_exclusive_with: [  ] }
    H9:
    - { name : md.spray_sel, live_start : 3, live_end : 3, mutually_exclusive_with: [  ] }
    H10:
    - { name : hdr.evid.rtt_q, live_start : parser, live_end : deparser, mutually_exclusive_with: [  ] }
    - { name : hdr.evid.loss_q, live_start : parser, live_end : deparser, mutually_exclusive_with: [  ] }
    H11:
    - { name : hdr.csig.worst_qdepth, live_start : parser, live_end : deparser, mutually_exclusive_with: [  ] }
    H12:
    - { name : hdr.udp.checksum, live_start : parser, live_end : deparser, mutually_exclusive_with: [  ] }
    H13:
    - { name : hdr.udp.src_port, live_start : parser, live_end : deparser, mutually_exclusive_with: [  ] }
    H14:
    - { name : hdr.fabric.vsw_id, live_start : parser, live_end : deparser, mutually_exclusive_with: [  ] }
    - { name : hdr.fabric.hop, live_start : parser, live_end : deparser, mutually_exclusive_with: [  ] }
    H15:
    - { name : ig_intr_md.ingress_port, live_start : parser, live_end : 0, mutually_exclusive_with: [  ] }
    - { name : md.next_vsw, live_start : 2, live_end : 7, mutually_exclusive_with: [  ] }
    - { name : md.attn, live_start : 2, live_end : 6, mutually_exclusive_with: [  ] }
    H32:
    - { name : hdr.ethernet.ether_type, live_start : parser, live_end : deparser, mutually_exclusive_with: [  ] }
    W0:
    - { name : hdr.ipv4.dst_addr, live_start : parser, live_end : deparser, mutually_exclusive_with: [  ] }
    W1:
    - { name : hdr.ipv4.src_addr, live_start : parser, live_end : deparser, mutually_exclusive_with: [  ] }
    W2:
    - { name : md.role, live_start : 1, live_end : 7, mutually_exclusive_with: [  ] }
    - { name : md.hop, live_start : parser, live_end : 7, mutually_exclusive_with: [  ] }
    W3:
    - { name : md.vlink_id, live_start : 5, live_end : 5, mutually_exclusive_with: [  ] }
    - { name : md.exceed, live_start : 4, live_end : 5, mutually_exclusive_with: [  ] }
    W4:
    - { name : md.src_leaf, live_start : 1, live_end : 4, mutually_exclusive_with: [  ] }
    - { name : md.dst_leaf, live_start : 2, live_end : 7, mutually_exclusive_with: [  ] }
    W5:
    - { name : md.rnd_fail, live_start : 4, live_end : 5, mutually_exclusive_with: [  ] }
    - { name : md.rnd_attn, live_start : 2, live_end : 6, mutually_exclusive_with: [  ] }
phv egress:
  eg_intr_md.egress_port: H16(0..8)
  hdr.ethernet.dst_addr.0-15: TH0
  hdr.ethernet.dst_addr.16-31: TH1
  hdr.ethernet.dst_addr.32-47: TH23
  hdr.ethernet.src_addr.0-31: TW3
  hdr.ethernet.src_addr.32-47: TH22
  hdr.ethernet.ether_type: TH21
  hdr.fabric.vsw_id: TH20(8..15)
  hdr.fabric.hop: TH20(0..7)
  hdr.fabric.spray: TW0(24..31)
  hdr.fabric.loops: TW0(16..23)
  hdr.fabric.flags: TW0(8..15)
  hdr.fabric.nxt: TW0(0..7)
  hdr.csig.worst_hop: TW1(24..31)
  hdr.csig.worst_vlink: TW1(16..23)
  hdr.csig.worst_qdepth: TW1(0..15)
  hdr.csig.worst_tdelta.0-15: TH2
  hdr.csig.worst_tdelta.16-31: TH3
  hdr.csig.path_id: TW2(16..31)
  hdr.csig.epoch: TW2(0..15)
  hdr.min_parse_depth_padding_0$0.packet_payload.0-15: TH4
  hdr.min_parse_depth_padding_0$0.packet_payload.16-31: TH5
  hdr.min_parse_depth_padding_0$0.packet_payload.32-63: TW12
  hdr.min_parse_depth_padding_0$0.packet_payload.64-71: TB3
  hdr.min_parse_depth_padding_0$0.packet_payload.72-79: TB12
  hdr.min_parse_depth_padding_0$0.packet_payload.80-87: TB0
  hdr.min_parse_depth_padding_0$1.packet_payload.0-31: TW13
  hdr.min_parse_depth_padding_0$1.packet_payload.32-63: TW14
  hdr.min_parse_depth_padding_0$1.packet_payload.64-71: TB13
  hdr.min_parse_depth_padding_0$1.packet_payload.72-79: TB14
  hdr.min_parse_depth_padding_0$1.packet_payload.80-87: TB1
  hdr.min_parse_depth_padding_0$2.packet_payload.0-31: TW15
  hdr.min_parse_depth_padding_0$2.packet_payload.32-47: TH18
  hdr.min_parse_depth_padding_0$2.packet_payload.48-63: TH19
  hdr.min_parse_depth_padding_0$2.packet_payload.64-79: TH24
  hdr.min_parse_depth_padding_0$2.packet_payload.80-87: TB2
  hdr.ethernet.$valid: B17(0)
  hdr.fabric.$valid: B17(1)
  hdr.csig.$valid: B17(2)
  hdr.min_parse_depth_padding_0.$stkvalid: B16(0..2)
  hdr.min_parse_depth_padding_0$0.$valid: {  stage 12: B16(2) } 
  hdr.min_parse_depth_padding_0$1.$valid: {  stage 12: B16(1) } 
  hdr.min_parse_depth_padding_0$2.$valid: B16(0)
  context_json:
    B16:
    - { name : hdr.min_parse_depth_padding_0$2.$valid, live_start : parser, live_end : deparser, mutually_exclusive_with: [  ] }
    - { name : hdr.min_parse_depth_padding_0.$stkvalid, live_start : parser, live_end : deparser, mutually_exclusive_with: [  ] }
    - { name : hdr.min_parse_depth_padding_0$0.$valid, live_start : deparser, live_end : deparser, mutually_exclusive_with: [  ] }
    - { name : hdr.min_parse_depth_padding_0$1.$valid, live_start : deparser, live_end : deparser, mutually_exclusive_with: [  ] }
    B17:
    - { name : hdr.ethernet.$valid, live_start : parser, live_end : deparser, mutually_exclusive_with: [  ] }
    - { name : hdr.fabric.$valid, live_start : parser, live_end : deparser, mutually_exclusive_with: [  ] }
    - { name : hdr.csig.$valid, live_start : parser, live_end : deparser, mutually_exclusive_with: [  ] }
    H16:
    - { name : eg_intr_md.egress_port, live_start : parser, live_end : deparser, mutually_exclusive_with: [  ] }
parser ingress:
  start: $entry_point.start
  init_zero: [ W2, W4, B6, H8, H4, H5, H6, H9, W3, W5, B5, H15, B3, B4, H3, B7, B1, B0, H1 ]
  bitwise_or: [ H3 ]
  hdr_len_adj: 16
  states:
    $entry_point.start:
      *:
        0..1: H15  # bit[7..15] -> H15 bit[8..0]: ingress::ig_intr_md.ingress_port
        16..17: TH13  # ingress::hdr.ethernet.dst_addr[47:32].32-47
        18..21: TW8  # ingress::hdr.ethernet.dst_addr[31:0].0-31
        22..23: TH12  # ingress::hdr.ethernet.src_addr[47:32].32-47
        24: TB6  # ingress::hdr.ethernet.src_addr[31:24].24-31
        25: TB5  # ingress::hdr.ethernet.src_addr[23:16].16-23
        26..27: TH11  # ingress::hdr.ethernet.src_addr[15:0].0-15
        H3: 1  # value 1 -> H3 bit[0]: ingress::hdr.ethernet.$valid
        load: { half : 28..29 }
        shift: 28
        buf_req: 30
        next: $entry_point.start.$split_0
    $entry_point.start.$split_0:
      match: [ half ]
      0x88f0:
        0..1: H32  # ingress::hdr.ethernet.ether_type
        load: { byte1 : 7 }
        shift: 2
        buf_req: 8
        next: parse_fabric
      0x0800:
        0..1: H32  # ingress::hdr.ethernet.ether_type
        shift: 2
        buf_req: 2
        next: parse_ipv4
      0x****:
        0..1: H32  # ingress::hdr.ethernet.ether_type
        shift: 2
        buf_req: 2
        next: end
    parse_fabric:
      match: [ byte1 ]
      0x01:
        0..1: H14
            # - bit[0..7] -> H14 bit[15..8]: ingress::hdr.fabric.vsw_id
            # - bit[8..15] -> H14 bit[7..0]: ingress::hdr.fabric.hop
        0..3: W2  # bit[8..15] -> W2 bit[23..16]: ingress::md.hop[7:0].0-7
        1..2: H8  # bit[16..23] -> H8 bit[7..0]: ingress::md.spray_idx[7:0].0-7
        2..3: H7
            # - bit[16..23] -> H7 bit[15..8]: ingress::hdr.fabric.spray
            # - bit[24..31] -> H7 bit[7..0]: ingress::hdr.fabric.loops
        4..5: H2
            # - bit[32..39] -> H2 bit[15..8]: ingress::hdr.fabric.flags
            # - bit[40..47] -> H2 bit[7..0]: ingress::hdr.fabric.nxt
        H3: 2  # value 1 -> H3 bit[1]: ingress::hdr.fabric.$valid
        shift: 6
        buf_req: 6
        next: parse_csig
      0x**:
        0..1: H14
            # - bit[0..7] -> H14 bit[15..8]: ingress::hdr.fabric.vsw_id
            # - bit[8..15] -> H14 bit[7..0]: ingress::hdr.fabric.hop
        0..3: W2  # bit[8..15] -> W2 bit[23..16]: ingress::md.hop[7:0].0-7
        1..2: H8  # bit[16..23] -> H8 bit[7..0]: ingress::md.spray_idx[7:0].0-7
        2..3: H7
            # - bit[16..23] -> H7 bit[15..8]: ingress::hdr.fabric.spray
            # - bit[24..31] -> H7 bit[7..0]: ingress::hdr.fabric.loops
        4..5: H2
            # - bit[32..39] -> H2 bit[15..8]: ingress::hdr.fabric.flags
            # - bit[40..47] -> H2 bit[7..0]: ingress::hdr.fabric.nxt
        H3: 2  # value 1 -> H3 bit[1]: ingress::hdr.fabric.$valid
        shift: 6
        buf_req: 6
        next: parse_ipv4
    parse_csig:
      *:
        0..1: TH6
            # - bit[0..7] -> TH6 bit[15..8]: ingress::hdr.csig.worst_hop
            # - bit[8..15] -> TH6 bit[7..0]: ingress::hdr.csig.worst_vlink
        2..3: H11  # ingress::hdr.csig.worst_qdepth
        4..7: TW9  # ingress::hdr.csig.worst_tdelta
        8: B4  # ingress::md.attn_idx[15:8].8-15
        8..9: TH8  # ingress::hdr.csig.path_id
        9: B3  # ingress::md.attn_idx[7:0].0-7
        10..11: TH7  # ingress::hdr.csig.epoch
        H3: 4  # value 1 -> H3 bit[2]: ingress::hdr.csig.$valid
        shift: 12
        buf_req: 12
        next: parse_ipv4
    parse_ipv4:
      *:
        0..3: TW4
            # - bit[0..3] -> TW4 bit[31..28]: ingress::hdr.ipv4.version
            # - bit[4..7] -> TW4 bit[27..24]: ingress::hdr.ipv4.ihl
            # - bit[8..15] -> TW4 bit[23..16]: ingress::hdr.ipv4.diffserv
            # - bit[16..31] -> TW4 bit[15..0]: ingress::hdr.ipv4.total_len
        4..7: TW6
            # - bit[32..47] -> TW6 bit[31..16]: ingress::hdr.ipv4.identification
            # - bit[48..50] -> TW6 bit[15..13]: ingress::hdr.ipv4.flags
            # - bit[51..63] -> TW6 bit[12..0]: ingress::hdr.ipv4.frag_offset
        8..11: TW5
            # - bit[64..71] -> TW5 bit[31..24]: ingress::hdr.ipv4.ttl
            # - bit[72..79] -> TW5 bit[23..16]: ingress::hdr.ipv4.protocol
            # - bit[80..95] -> TW5 bit[15..0]: ingress::hdr.ipv4.hdr_checksum
        12..15: W1  # ingress::hdr.ipv4.src_addr
        H3: 8  # value 1 -> H3 bit[3]: ingress::hdr.ipv4.$valid
        load: { byte1 : 9 }
        shift: 16
        buf_req: 16
        next: parse_ipv4.$split_0
    parse_ipv4.$split_0:
      match: [ byte1 ]
      0x11:
        0..3: W0  # ingress::hdr.ipv4.dst_addr
        load: { half : 6..7 }
        shift: 4
        buf_req: 8
        next: parse_udp
      0x**:
        0..3: W0  # ingress::hdr.ipv4.dst_addr
        shift: 4
        buf_req: 4
        next: end
    parse_udp:
      match: [ half ]
      0x12b7:
        0..1: H13  # ingress::hdr.udp.src_port
        2..3: TH10  # ingress::hdr.udp.dst_port
        4..5: TH9  # ingress::hdr.udp.len
        6..7: H12  # ingress::hdr.udp.checksum
        H3: 16  # value 1 -> H3 bit[4]: ingress::hdr.udp.$valid
        shift: 8
        buf_req: 8
        next: parse_bth
      0xe5e5:
        0..1: H13  # ingress::hdr.udp.src_port
        2..3: TH10  # ingress::hdr.udp.dst_port
        4..5: TH9  # ingress::hdr.udp.len
        6..7: H12  # ingress::hdr.udp.checksum
        H3: 16  # value 1 -> H3 bit[4]: ingress::hdr.udp.$valid
        shift: 8
        buf_req: 8
        next: parse_evid
      0x****:
        0..1: H13  # ingress::hdr.udp.src_port
        2..3: TH10  # ingress::hdr.udp.dst_port
        4..5: TH9  # ingress::hdr.udp.len
        6..7: H12  # ingress::hdr.udp.checksum
        H3: 16  # value 1 -> H3 bit[4]: ingress::hdr.udp.$valid
        shift: 8
        buf_req: 8
        next: end
    parse_bth:
      *:
        0..3: TW11  # ingress::hdr.bth.w0
        4..7: TW10  # ingress::hdr.bth.w1
        8..11: TW7  # ingress::hdr.bth.w2
        H3: 32  # value 1 -> H3 bit[5]: ingress::hdr.bth.$valid
        shift: 12
        buf_req: 12
        next: end
    parse_evid:
      *:
        0: TB4  # ingress::hdr.evid.magic
        1: B2  # ingress::hdr.evid.path_id
        2..3: H10
            # - bit[16..23] -> H10 bit[15..8]: ingress::hdr.evid.rtt_q
            # - bit[24..31] -> H10 bit[7..0]: ingress::hdr.evid.loss_q
        4..7: TW7
            # - bit[32..39] -> TW7 bit[31..24]: ingress::hdr.evid.ecn_q
            # - bit[40..47] -> TW7 bit[23..16]: ingress::hdr.evid.flags
            # - bit[48..63] -> TW7 bit[15..0]: ingress::hdr.evid.seq
        H3: 64  # value 1 -> H3 bit[6]: ingress::hdr.evid.$valid
        shift: 8
        buf_req: 8
        next: end
deparser ingress:
  dictionary:
    TH13: H3(0)  # ingress::hdr.ethernet.dst_addr.32-47 if ingress::hdr.ethernet.$valid
    TW8: H3(0)  # ingress::hdr.ethernet.dst_addr.0-31 if ingress::hdr.ethernet.$valid
    TH12: H3(0)  # ingress::hdr.ethernet.src_addr.32-47 if ingress::hdr.ethernet.$valid
    TB6: H3(0)  # ingress::hdr.ethernet.src_addr.24-31 if ingress::hdr.ethernet.$valid
