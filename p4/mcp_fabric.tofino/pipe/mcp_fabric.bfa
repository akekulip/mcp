    match: [ md.role(10..15), md.hop(0..7), md.hop(8..15), md.dst_leaf(0..7), md.dst_leaf(8..15) ]
    match_group_map: [ [ 0 ] ]
    hit: [  END ]
    miss:  END
    action_bus: { 64..65 : immediate(0..15), 66..67 : immediate(16..23) }
    instruction: tbl_final_0(action, $DEFAULT)
