      - { group: 0, index: 10..19, select: 40..51 & 0x0, rams: [[7, 3]] }
      - { group: 0, index: 20..29, select: 40..51 & 0x0, rams: [[7, 4]] }
      - { group: 0, index: 30..39, select: 40..51 & 0x0, rams: [[7, 6]] }
    hash_dist:
      0: { hash: 1, mask: 0xffff, shift: 5 }
    input_xbar:
      exact group 0: { 16: md.exceed }
