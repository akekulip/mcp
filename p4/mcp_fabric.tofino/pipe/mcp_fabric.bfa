    default_action: mcp_fabric709
stage 7 ingress:
  dependency: action
  exact_match tbl_final_0 0:
    p4: { name: Ingress.tbl_final, size: 64 }
    p4_param_order: 
      md.role: { type: exact, size: 16, full_size: 16 }
      md.hop: { type: exact, size: 16, full_size: 16 }
      md.dst_leaf: { type: exact, size: 16, full_size: 16 }
    row: 7
