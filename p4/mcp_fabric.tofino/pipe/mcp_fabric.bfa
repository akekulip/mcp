        0..7: random(md.exceed(10..15)) ^ md.exceed(0..7)
        8..9: random(md.exceed(10..15)) ^ md.exceed(8..9)
        11..18: random(md.exceed(10..15)) ^ md.exceed(0..7)
        19: random(md.exceed(10..15)) ^ md.exceed(8)
        10: random(md.exceed(10..15)) ^ md.exceed(9)
        22..29: random(md.exceed(10..15)) ^ md.exceed(0..7)
        20..21: random(md.exceed(10..15)) ^ md.exceed(8..9)
        33..39: random(md.exceed(10..15)) ^ md.exceed(0..6)
        30: random(md.exceed(10..15)) ^ md.exceed(7)
        31..32: random(md.exceed(10..15)) ^ md.exceed(8..9)
      hash group 0:
