    B20:
    - { name : hdr.csig.worst_hop, live_start : parser, live_end : deparser, mutually_exclusive_with: [  ] }
    B21:
    - { name : md.hop, live_start : 1, live_end : 2, mutually_exclusive_with: [  ] }
    B22:
    - { name : hdr.ethernet.$valid, live_start : parser, live_end : deparser, mutually_exclusive_with: [  ] }
    - { name : hdr.fabric.$valid, live_start : parser, live_end : deparser, mutually_exclusive_with: [  ] }
    - { name : hdr.csig.$valid, live_start : parser, live_end : deparser, mutually_exclusive_with: [  ] }
