    TB11: B1(5)  # ingress::hdr.bth.w0.24-31 if ingress::hdr.bth.$valid
    TB10: B1(5)  # ingress::hdr.bth.w0.16-23 if ingress::hdr.bth.$valid
    TB9: B1(5)  # ingress::hdr.bth.w0.8-15 if ingress::hdr.bth.$valid
