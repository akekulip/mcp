      - p4_param_order: { next_hop: 8 }
      - hit_allowed: { allowed: true }
      - default_action: { allowed: false, reason: has_const_default_action }
      - handle: 0x2000001e
      - next_table: 0
      - { next_hop: immediate(0..7), $constant0: immediate(16..23), $constant0: 0 }
      - set hdr.fabric.$valid, 1
      - set hdr.ethernet.ether_type, 35056
      - deposit-field H2(0..7), 0, H3
      - byte-rotate-merge H7, $constant0, H8, 0, 1, 1
      - deposit-field H14(0..7), next_hop, H15
      Ingress.act_transit(1, 2):
      - p4_param_order: { next_hop: 8 }
      - hit_allowed: { allowed: true }
      - default_action: { allowed: false, reason: has_const_default_action }
      - handle: 0x2000001f
      - next_table: 0
      - { next_hop_2: immediate(0..7), next_hop: next_hop_2 }
      - set hdr.fabric.flags, md.flags_out.0-7
      - deposit-field H14(0..7), next_hop, H15
      Ingress.act_deliver(2, 3):
      - p4_param_order: { port: 9 }
      - hit_allowed: { allowed: true }
      - default_action: { allowed: false, reason: has_const_default_action }
      - handle: 0x20000020
      - next_table: 0
      - { port: immediate(0..8) }
      - set hdr.ethernet.ether_type, 2048
      - set ig_intr_md_for_tm.ucast_egress_port, port
      - set ig_intr_md_for_tm.qid, 0
      - set H3(1..2), 0
      Ingress.act_drop(3, 4):
      - hit_allowed: { allowed: true }
      - default_action: { allowed: true, is_constant: true }
      - handle: 0x20000021
      - next_table: 0
      - {  }
      - set ig_intr_md_for_dprsr.drop_ctl, 1
    default_action: Ingress.act_drop


