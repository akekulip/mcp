parser ingress:
  start: $init_match
  init_zero: [ B0, H0, B1 ]
  bitwise_or: [ B1 ]
  hdr_len_adj: 16
  states:
    $init_match:
      *:
        16..17: TH27  # ingress::hdr.ethernet.dst_addr[47:32].32-47
        18..21: TW11  # ingress::hdr.ethernet.dst_addr[31:0].0-31
        22..23: TH26  # ingress::hdr.ethernet.src_addr[47:32].32-47
        24..27: TW10  # ingress::hdr.ethernet.src_addr[31:0].0-31
        28..29: TH25  # ingress::hdr.ethernet.ether_type
        B1: 1  # value 1 -> B1 bit[0]: ingress::hdr.ethernet.$valid
        load: { half : 28..29 }
        shift: 30
        buf_req: 30
        next: $entry_point.start
    $entry_point.start:
      match: [ half ]
      0x88f0:
        0..1: TH24
            # - bit[0..7] -> TH24 bit[15..8]: ingress::hdr.fabric.vsw_id
            # - bit[8..15] -> TH24 bit[7..0]: ingress::hdr.fabric.hop
        2..5: TW4
            # - bit[16..23] -> TW4 bit[31..24]: ingress::hdr.fabric.spray
            # - bit[24..31] -> TW4 bit[23..16]: ingress::hdr.fabric.loops
            # - bit[32..39] -> TW4 bit[15..8]: ingress::hdr.fabric.flags
            # - bit[40..47] -> TW4 bit[7..0]: ingress::hdr.fabric.nxt
        B1: 2  # value 1 -> B1 bit[1]: ingress::hdr.fabric.$valid
        load: { byte1 : 5 }
        shift: 6
        buf_req: 6
        next: parse_fabric
      0x0800:
        0..3: TW5
            # - bit[0..3] -> TW5 bit[31..28]: ingress::hdr.ipv4.version
            # - bit[4..7] -> TW5 bit[27..24]: ingress::hdr.ipv4.ihl
            # - bit[8..15] -> TW5 bit[23..16]: ingress::hdr.ipv4.diffserv
            # - bit[16..31] -> TW5 bit[15..0]: ingress::hdr.ipv4.total_len
        4..5: TH9  # ingress::hdr.ipv4.identification
        6..7: TH8
            # - bit[48..50] -> TH8 bit[15..13]: ingress::hdr.ipv4.flags
            # - bit[51..63] -> TH8 bit[12..0]: ingress::hdr.ipv4.frag_offset
        8..9: TH7
            # - bit[64..71] -> TH7 bit[15..8]: ingress::hdr.ipv4.ttl
            # - bit[72..79] -> TH7 bit[7..0]: ingress::hdr.ipv4.protocol
        10..11: TH6  # ingress::hdr.ipv4.hdr_checksum
        B1: 8  # value 1 -> B1 bit[3]: ingress::hdr.ipv4.$valid
        load: { byte1 : 9 }
        shift: 12
        buf_req: 12
        next: parse_ipv4.$split_0
      0x****:
        buf_req: 0
        next: end
    parse_fabric:
      match: [ byte1 ]
      0x01:
        0..3: TW7
            # - bit[0..7] -> TW7 bit[31..24]: ingress::hdr.csig.worst_hop
            # - bit[8..15] -> TW7 bit[23..16]: ingress::hdr.csig.worst_vlink
            # - bit[16..31] -> TW7 bit[15..0]: ingress::hdr.csig.worst_qdepth
        4..5: TH13  # ingress::hdr.csig.worst_tdelta[31:16].16-31
        6..7: TH12  # ingress::hdr.csig.worst_tdelta[15:0].0-15
        8: TB7  # ingress::hdr.csig.path_id[15:8].8-15
        9: TB6  # ingress::hdr.csig.path_id[7:0].0-7
        10: TB5  # ingress::hdr.csig.epoch[15:8].8-15
        11: TB4  # ingress::hdr.csig.epoch[7:0].0-7
        shift: 12
        buf_req: 12
        next: parse_csig.$split_0
      0x**:
        0..3: TW5
            # - bit[0..3] -> TW5 bit[31..28]: ingress::hdr.ipv4.version
            # - bit[4..7] -> TW5 bit[27..24]: ingress::hdr.ipv4.ihl
            # - bit[8..15] -> TW5 bit[23..16]: ingress::hdr.ipv4.diffserv
            # - bit[16..31] -> TW5 bit[15..0]: ingress::hdr.ipv4.total_len
        4..5: TH9  # ingress::hdr.ipv4.identification
        6..7: TH8
            # - bit[48..50] -> TH8 bit[15..13]: ingress::hdr.ipv4.flags
            # - bit[51..63] -> TH8 bit[12..0]: ingress::hdr.ipv4.frag_offset
        8..9: TH7
            # - bit[64..71] -> TH7 bit[15..8]: ingress::hdr.ipv4.ttl
            # - bit[72..79] -> TH7 bit[7..0]: ingress::hdr.ipv4.protocol
        10..11: TH6  # ingress::hdr.ipv4.hdr_checksum
        B1: 8  # value 1 -> B1 bit[3]: ingress::hdr.ipv4.$valid
        load: { byte1 : 9 }
        shift: 12
        buf_req: 12
        next: parse_ipv4.$split_0
    parse_csig.$split_0:
      *:
        B1: 4  # value 1 -> B1 bit[2]: ingress::hdr.csig.$valid
        buf_req: 0
        next: parse_ipv4
    parse_ipv4:
      *:
        0..3: TW5
            # - bit[0..3] -> TW5 bit[31..28]: ingress::hdr.ipv4.version
            # - bit[4..7] -> TW5 bit[27..24]: ingress::hdr.ipv4.ihl
            # - bit[8..15] -> TW5 bit[23..16]: ingress::hdr.ipv4.diffserv
            # - bit[16..31] -> TW5 bit[15..0]: ingress::hdr.ipv4.total_len
        4..5: TH9  # ingress::hdr.ipv4.identification
        6..7: TH8
            # - bit[48..50] -> TH8 bit[15..13]: ingress::hdr.ipv4.flags
            # - bit[51..63] -> TH8 bit[12..0]: ingress::hdr.ipv4.frag_offset
        8..9: TH7
            # - bit[64..71] -> TH7 bit[15..8]: ingress::hdr.ipv4.ttl
            # - bit[72..79] -> TH7 bit[7..0]: ingress::hdr.ipv4.protocol
        10..11: TH6  # ingress::hdr.ipv4.hdr_checksum
        B1: 8  # value 1 -> B1 bit[3]: ingress::hdr.ipv4.$valid
        load: { byte1 : 9 }
        shift: 12
        buf_req: 12
        next: parse_ipv4.$split_0
    parse_ipv4.$split_0:
      match: [ byte1 ]
      0x11:
        0..1: TH17  # ingress::hdr.ipv4.src_addr[31:16].16-31
        2..3: TH16  # ingress::hdr.ipv4.src_addr[15:0].0-15
        4..5: TH15  # ingress::hdr.ipv4.dst_addr[31:16].16-31
        6..7: TH14  # ingress::hdr.ipv4.dst_addr[15:0].0-15
        8..11: TW9
            # - bit[0..15] -> TW9 bit[31..16]: ingress::hdr.udp.src_port
            # - bit[16..31] -> TW9 bit[15..0]: ingress::hdr.udp.dst_port
        12..15: TW8
            # - bit[32..47] -> TW8 bit[31..16]: ingress::hdr.udp.len
            # - bit[48..63] -> TW8 bit[15..0]: ingress::hdr.udp.checksum
        B1: 16  # value 1 -> B1 bit[4]: ingress::hdr.udp.$valid
        load: { half : 10..11 }
        shift: 16
        buf_req: 16
        next: parse_udp
      0x**:
        0..1: TH17  # ingress::hdr.ipv4.src_addr[31:16].16-31
        2..3: TH16  # ingress::hdr.ipv4.src_addr[15:0].0-15
        4..5: TH15  # ingress::hdr.ipv4.dst_addr[31:16].16-31
        6..7: TH14  # ingress::hdr.ipv4.dst_addr[15:0].0-15
        shift: 8
        buf_req: 8
        next: end
    parse_udp:
      match: [ half ]
      0x12b7:
        0: TB11  # ingress::hdr.bth.w0[31:24].24-31
        1: TB10  # ingress::hdr.bth.w0[23:16].16-23
        2: TB9  # ingress::hdr.bth.w0[15:8].8-15
        3: TB8  # ingress::hdr.bth.w0[7:0].0-7
        4..5: TH11  # ingress::hdr.bth.w1[31:16].16-31
        6..7: TH10  # ingress::hdr.bth.w1[15:0].0-15
        8..11: TW6  # ingress::hdr.bth.w2
        shift: 12
        buf_req: 12
        next: parse_bth.$split_0
      0xe5e5:
        0..3: TW6
            # - bit[0..7] -> TW6 bit[31..24]: ingress::hdr.evid.magic
            # - bit[8..15] -> TW6 bit[23..16]: ingress::hdr.evid.path_id
            # - bit[16..23] -> TW6 bit[15..8]: ingress::hdr.evid.rtt_q
            # - bit[24..31] -> TW6 bit[7..0]: ingress::hdr.evid.loss_q
        4..5: TH11
            # - bit[32..39] -> TH11 bit[15..8]: ingress::hdr.evid.ecn_q
            # - bit[40..47] -> TH11 bit[7..0]: ingress::hdr.evid.flags
        6..7: TH10  # ingress::hdr.evid.seq
        B1: 64  # value 1 -> B1 bit[6]: ingress::hdr.evid.$valid
        shift: 8
        buf_req: 8
        next: end
      0x****:
        buf_req: 0
        next: end
    parse_bth.$split_0:
      *:
        B1: 32  # value 1 -> B1 bit[5]: ingress::hdr.bth.$valid
        buf_req: 0
        next: end
deparser ingress:
  dictionary:
    TH27: B1(0)  # ingress::hdr.ethernet.dst_addr.32-47 if ingress::hdr.ethernet.$valid
    TW11: B1(0)  # ingress::hdr.ethernet.dst_addr.0-31 if ingress::hdr.ethernet.$valid
    TH26: B1(0)  # ingress::hdr.ethernet.src_addr.32-47 if ingress::hdr.ethernet.$valid
    TW10: B1(0)  # ingress::hdr.ethernet.src_addr.0-31 if ingress::hdr.ethernet.$valid
    TH25: B1(0)  # ingress::hdr.ethernet.ether_type if ingress::hdr.ethernet.$valid
    TH24: B1(1)
        # - bit[15..8]: ingress::hdr.fabric.vsw_id if ingress::hdr.fabric.$valid
        # - bit[7..0]: ingress::hdr.fabric.hop if ingress::hdr.fabric.$valid
    TW4: B1(1)
        # - bit[31..24]: ingress::hdr.fabric.spray if ingress::hdr.fabric.$valid
        # - bit[23..16]: ingress::hdr.fabric.loops if ingress::hdr.fabric.$valid
        # - bit[15..8]: ingress::hdr.fabric.flags if ingress::hdr.fabric.$valid
        # - bit[7..0]: ingress::hdr.fabric.nxt if ingress::hdr.fabric.$valid
    TW7: B1(2)
        # - bit[31..24]: ingress::hdr.csig.worst_hop if ingress::hdr.csig.$valid
        # - bit[23..16]: ingress::hdr.csig.worst_vlink if ingress::hdr.csig.$valid
        # - bit[15..0]: ingress::hdr.csig.worst_qdepth if ingress::hdr.csig.$valid
    TH13: B1(2)  # ingress::hdr.csig.worst_tdelta.16-31 if ingress::hdr.csig.$valid
    TH12: B1(2)  # ingress::hdr.csig.worst_tdelta.0-15 if ingress::hdr.csig.$valid
    TB7: B1(2)  # ingress::hdr.csig.path_id.8-15 if ingress::hdr.csig.$valid
    TB6: B1(2)  # ingress::hdr.csig.path_id.0-7 if ingress::hdr.csig.$valid
    TB5: B1(2)  # ingress::hdr.csig.epoch.8-15 if ingress::hdr.csig.$valid
    TB4: B1(2)  # ingress::hdr.csig.epoch.0-7 if ingress::hdr.csig.$valid
    TW5: B1(3)
        # - bit[31..28]: ingress::hdr.ipv4.version if ingress::hdr.ipv4.$valid
        # - bit[27..24]: ingress::hdr.ipv4.ihl if ingress::hdr.ipv4.$valid
        # - bit[23..16]: ingress::hdr.ipv4.diffserv if ingress::hdr.ipv4.$valid
        # - bit[15..0]: ingress::hdr.ipv4.total_len if ingress::hdr.ipv4.$valid
    TH9: B1(3)  # ingress::hdr.ipv4.identification if ingress::hdr.ipv4.$valid
    TH8: B1(3)
        # - bit[15..13]: ingress::hdr.ipv4.flags if ingress::hdr.ipv4.$valid
        # - bit[12..0]: ingress::hdr.ipv4.frag_offset if ingress::hdr.ipv4.$valid
    TH7: B1(3)
        # - bit[15..8]: ingress::hdr.ipv4.ttl if ingress::hdr.ipv4.$valid
        # - bit[7..0]: ingress::hdr.ipv4.protocol if ingress::hdr.ipv4.$valid
    TH6: B1(3)  # ingress::hdr.ipv4.hdr_checksum if ingress::hdr.ipv4.$valid
    TH17: B1(3)  # ingress::hdr.ipv4.src_addr.16-31 if ingress::hdr.ipv4.$valid
    TH16: B1(3)  # ingress::hdr.ipv4.src_addr.0-15 if ingress::hdr.ipv4.$valid
    TH15: B1(3)  # ingress::hdr.ipv4.dst_addr.16-31 if ingress::hdr.ipv4.$valid
    TH14: B1(3)  # ingress::hdr.ipv4.dst_addr.0-15 if ingress::hdr.ipv4.$valid
    TW9: B1(4)
        # - bit[31..16]: ingress::hdr.udp.src_port if ingress::hdr.udp.$valid
        # - bit[15..0]: ingress::hdr.udp.dst_port if ingress::hdr.udp.$valid
    TW8: B1(4)
        # - bit[31..16]: ingress::hdr.udp.len if ingress::hdr.udp.$valid
