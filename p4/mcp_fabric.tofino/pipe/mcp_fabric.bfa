  md.attn.0-7: {  stage 2..6: H15(0..7) } 
  md.attn.8-15: {  stage 2..6: B5 } 
  md.attn_idx.0-7: {  stage 0..5: B3 } 
  md.attn_idx.8-15: {  stage 0..5: B4 } 
  md.exceed: {  stage 4..5: W3(16..31) } 
  md.flags_out.0-7: {  stage 6..7: H3(8..15) } 
