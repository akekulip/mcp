      - default_action: { allowed: false, reason: has_const_default_action }
      - handle: 0x20000020
      - next_table: 0
      - { port: $adf_h0(0..8) }
      - set hdr.ethernet.ether_type, 2048
      - set ig_intr_md_for_tm.ucast_egress_port, port
      - set ig_intr_md_for_tm.qid, 0
      - set H4(1..2), 0
      Ingress.act_drop(3, 4):
      - hit_allowed: { allowed: true }
      - default_action: { allowed: true, is_constant: true }
      - handle: 0x20000021
      - next_table: 0
      - {  }
      - set ig_intr_md_for_dprsr.drop_ctl, 1
    default_action: Ingress.act_drop
  action tbl_final_0$action_data:
    p4: { name: Ingress.tbl_final$action }
    row: 15
    logical_bus: A
    column: 0
    vpns: [ 0 ]
    home_row:
    - 15
    format Ingress.act_enter: { $adf_h0: 0..15 }
    format Ingress.act_transit: { $adf_h0: 0..15 }
    format Ingress.act_deliver: { $adf_h0: 0..15 }
    action_bus: { 32..33 : $adf_h0 }
stage 0 egress:
  exact_match tbl_eg_vlink_0 1:
    p4: { name: Egress.tbl_eg_vlink, size: 64 }
    p4_param_order: 
      eg_intr_md.egress_port: { type: exact, size: 9, full_size: 9 }
      eg_intr_md.egress_qid: { type: exact, size: 5, full_size: 5 }
    row: 7
    bus: 1
    column: [ 3, 4, 5, 6 ]
    stash: 
      row: [ 7 ]
      col: [ 3 ]
      unit: [ 1 ]
    ways:
      - { group: 1, index: 0..9, select: 40..51 & 0x0, rams: [[7, 3]] }
      - { group: 1, index: 10..19, select: 40..51 & 0x0, rams: [[7, 4]] }
      - { group: 1, index: 20..29, select: 40..51 & 0x0, rams: [[7, 5]] }
      - { group: 1, index: 30..39, select: 40..51 & 0x0, rams: [[7, 6]] }
    input_xbar:
      exact group 0: { 64: eg_intr_md.egress_qid, 72: eg_intr_md.egress_port(8), 80: eg_intr_md.egress_port(0..7) }
      hash 1:
        0..4: random(eg_intr_md.egress_port(4..7)) ^ eg_intr_md.egress_qid
        5: random(eg_intr_md.egress_port(4..7)) ^ eg_intr_md.egress_port(8)
        6..9: random(eg_intr_md.egress_port(4..7)) ^ eg_intr_md.egress_port(0..3)
        11..15: random(eg_intr_md.egress_port(4..7)) ^ eg_intr_md.egress_qid
        16: random(eg_intr_md.egress_port(4..7)) ^ eg_intr_md.egress_port(8)
        17..19: random(eg_intr_md.egress_port(4..7)) ^ eg_intr_md.egress_port(0..2)
        10: random(eg_intr_md.egress_port(4..7)) ^ eg_intr_md.egress_port(3)
        22..26: random(eg_intr_md.egress_port(4..7)) ^ eg_intr_md.egress_qid
        27: random(eg_intr_md.egress_port(4..7)) ^ eg_intr_md.egress_port(8)
        28..29: random(eg_intr_md.egress_port(4..7)) ^ eg_intr_md.egress_port(0..1)
        20..21: random(eg_intr_md.egress_port(4..7)) ^ eg_intr_md.egress_port(2..3)
        33..37: random(eg_intr_md.egress_port(4..7)) ^ eg_intr_md.egress_qid
        38: random(eg_intr_md.egress_port(4..7)) ^ eg_intr_md.egress_port(8)
        39: random(eg_intr_md.egress_port(4..7)) ^ eg_intr_md.egress_port(0)
        30..32: random(eg_intr_md.egress_port(4..7)) ^ eg_intr_md.egress_port(1..3)
      hash group 1:
        table: [1]
        seed: 0xbc63abbd62
    format: { action(0): 0..0, immediate(0): 3..18, version(0): 112..115, match(0): 52..55, action(1): 1..1, immediate(1): 19..34, version(1): 56..59, match(1): 60..63, action(2): 2..2, immediate(2): 35..50, version(2): 64..67, match(2): 68..71 }
    match: [ eg_intr_md.egress_port(4..7) ]
    match_group_map: [ [ 0, 1, 2 ] ]
    gateway:
      name: cond-15
      input_xbar:
        exact group 0: { 18: hdr.csig.$valid }
      row: 7
      bus: 0
      unit: 0
      match: { 2: hdr.csig.$valid }
      0x1:
        run_table: true
      miss:
        next:  END
      condition: 
        expression: "(hdr.csig.$valid == 1)"
        true:  tbl_eg_vlink_0
        false:  END
    hit: [  tbl_csig_diff_0 ]
    miss:  tbl_csig_diff_0
    action_bus: { 36..37 : immediate(0..15) }
    instruction: tbl_eg_vlink_0(action, $DEFAULT)
    actions:
      Egress.set_eg_vlink(1, 1):
      - p4_param_order: { vlink: 16 }
      - hit_allowed: { allowed: true }
      - default_action: { allowed: true, is_constant: true }
      - handle: 0x20000022
      - next_table: 0
      - { vlink_1: immediate(0..15), vlink: vlink_1 }
      - set md.vlink, vlink
      - set md.this_q, eg_intr_md.deq_qdepth.0-15
      - set md.hop.0-7, hdr.fabric.hop
      - set md.tdelta(0..17), eg_intr_md.deq_timedelta
    default_action: Egress.set_eg_vlink
    default_action_parameters:
      vlink: "0x0"
stage 1 egress:
  dependency: match
  ternary_match tbl_csig_diff_0 4:
    p4: { name: Egress.tbl_csig_diff, size: 1 }
    hit: [  tbl_csig_replace_b_0 ]
    miss:  tbl_csig_replace_b_0
    indirect: tbl_csig_diff_0$tind
  ternary_indirect tbl_csig_diff_0$tind:
    row: 1
    bus: 0
    format: { action: 0..0 }
    instruction: tbl_csig_diff_0$tind(action, $DEFAULT)
    actions:
      Egress.csig_diff(0, 1):
      - hit_allowed: { allowed: true }
      - default_action: { allowed: true, is_constant: true }
      - handle: 0x20000023
      - next_table: 0
      - ssubu H19, H17, H18
    default_action: Egress.csig_diff
stage 2 egress:
  dependency: match
  ternary_match tbl_csig_replace_b_0 1:
    p4: { name: Egress.tbl_csig_replace_b, size: 1 }
    gateway:
      name: cond-16
      input_xbar:
        exact group 0: { 0: md.diff(0..7), 40: md.diff(8..15) }
      row: 7
      bus: 0
      unit: 0
      match: { 0: md.diff(0..7), 8: md.diff(8..15) }
      0x0000:
        run_table: true
      miss:
        next:  END
      condition: 
        expression: "(md.diff == 0)"
        true:  tbl_csig_replace_b_0
        false:  END
    hit: [  tbl_csig_replace_a_0 ]
    miss:  tbl_csig_replace_a_0
    indirect: tbl_csig_replace_b_0$tind
  ternary_indirect tbl_csig_replace_b_0$tind:
    row: 0
    bus: 0
    format: { action: 0..0 }
    instruction: tbl_csig_replace_b_0$tind(action, $DEFAULT)
    actions:
      Egress.csig_replace_b(1, 1):
      - hit_allowed: { allowed: true }
      - default_action: { allowed: true, is_constant: true }
      - handle: 0x20000025
      - next_table: 0
      - set hdr.csig.worst_vlink, md.vlink
      - set hdr.csig.worst_tdelta, md.tdelta
    default_action: Egress.csig_replace_b
  ternary_match tbl_csig_replace_a_0 2:
    p4: { name: Egress.tbl_csig_replace_a, size: 1 }
    hit: [  END ]
    miss:  END
    indirect: tbl_csig_replace_a_0$tind
  ternary_indirect tbl_csig_replace_a_0$tind:
    row: 0
    bus: 1
    format: { action: 0..0 }
    instruction: tbl_csig_replace_a_0$tind(action, $DEFAULT)
    actions:
      Egress.csig_replace_a(0, 2):
      - hit_allowed: { allowed: true }
      - default_action: { allowed: true, is_constant: true }
      - handle: 0x20000024
      - next_table: 0
      - set hdr.csig.worst_hop.0-7, md.hop.0-7
      - set hdr.csig.worst_hop.8-15, md.hop.8-15
      - set hdr.csig.worst_qdepth, md.this_q
    default_action: Egress.csig_replace_a


