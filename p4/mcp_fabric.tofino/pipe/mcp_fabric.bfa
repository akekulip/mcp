  stateful tbl_attn_0$salu.Ingress.reg_attn:
    p4: { name: Ingress.reg_attn, size: 256 }
    row: 15
    logical_bus: S
    column: [ 1, 2 ]
    maprams: [ 1, 2 ]
    home_row: 15
    format: { lo: 16, hi:16 }
    register_params: { 0: { Ingress.p_k_up: 1024 }, 1: { Ingress.p_n_clean_m1: 4095 }, 2: { Ingress.p_a_min: 256 } }
    actions:
      attn_on_exceed_0:
      - saddu lo, lo, register_param(0)
      - alu_a hi, 0
      - output alu_lo
      attn_on_clean_0:
      - leq.u lo, -hi, register_param(1)
      - lss.u hi, -lo, register_param(2)
      - alu_a ((cmplo & (!cmplo | !cmphi)) | (cmplo & cmphi)), hi, 0
      - add (cmplo & cmphi), lo, lo, 65535
      - add (!cmplo & (!cmplo | !cmphi)), hi, hi, 1
      - output alu_lo
stage 6 ingress:
  dependency: match
  ternary_match tbl_gate_0 0:
