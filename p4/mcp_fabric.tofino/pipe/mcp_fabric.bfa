  eg_intr_md.deq_timedelta: {  stage 0: W16(0..17) } 
  eg_intr_md.egress_qid: {  stage 0: W19(0..4) } 
  hdr.ethernet.dst_addr.0-31: TW3
  hdr.ethernet.dst_addr.32-47: TH19
  hdr.ethernet.src_addr.0-31: TW2
  hdr.ethernet.src_addr.32-47: TH18
  hdr.ethernet.ether_type: TH5
  hdr.fabric.vsw_id: TB3
  hdr.fabric.hop: B17
  hdr.fabric.spray: TH0(8..15)
  hdr.fabric.loops: TH0(0..7)
  hdr.fabric.flags: TW0(24..31)
  hdr.fabric.nxt: TW0(16..23)
  hdr.fabric.path_id: TW0(0..15)
  hdr.csig.worst_hop.0-7: B18
  hdr.csig.worst_hop.8-15: B20
  hdr.csig.worst_vlink: H21
  hdr.csig.worst_qdepth: H17
  hdr.csig.worst_tdelta: W17
  hdr.csig.path_id: TW1(16..31)
  hdr.csig.epoch: TW1(0..15)
  hdr.min_parse_depth_padding_0$0.packet_payload.0-15: TH1
  hdr.min_parse_depth_padding_0$0.packet_payload.16-31: TH2
  hdr.min_parse_depth_padding_0$0.packet_payload.32-47: TH3
  hdr.min_parse_depth_padding_0$0.packet_payload.48-63: TH4
  hdr.min_parse_depth_padding_0$0.packet_payload.64-79: TH20
  hdr.min_parse_depth_padding_0$0.packet_payload.80-87: TB0
  hdr.min_parse_depth_padding_0$1.packet_payload.0-31: TW12
  hdr.min_parse_depth_padding_0$1.packet_payload.32-63: TW13
  hdr.min_parse_depth_padding_0$1.packet_payload.64-79: TH21
  hdr.min_parse_depth_padding_0$1.packet_payload.80-87: TB1
  hdr.min_parse_depth_padding_0$2.packet_payload.0-31: TW14
  hdr.min_parse_depth_padding_0$2.packet_payload.32-63: TW15
  hdr.min_parse_depth_padding_0$2.packet_payload.64-79: TH22
  hdr.min_parse_depth_padding_0$2.packet_payload.80-87: TB2
  md.this_q: {  stage 1..2: H18 } 
  md.diff: {  stage 2: H19 } 
  md.vlink: {  stage 1..2: H22 } 
  md.hop.0-7: {  stage 1..2: B19 } 
  md.hop.8-15: {  stage 1..2: B21 } 
  md.tdelta: {  stage 1..2: W18 } 
  hdr.ethernet.$valid: B22(0)
  hdr.fabric.$valid: B22(1)
  hdr.csig.$valid: B22(2)
