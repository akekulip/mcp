  hdr.csig.epoch: TH7
  hdr.ipv4.version: TW4(28..31)
  hdr.ipv4.ihl: TW4(24..27)
  hdr.ipv4.diffserv: TW4(16..23)
  hdr.ipv4.total_len: TW4(0..15)
  hdr.ipv4.identification: TW6(16..31)
  hdr.ipv4.flags: TW6(13..15)
  hdr.ipv4.frag_offset: TW6(0..12)
  hdr.ipv4.ttl: TW5(24..31)
  hdr.ipv4.protocol: TW5(16..23)
  hdr.ipv4.hdr_checksum: TW5(0..15)
  hdr.ipv4.src_addr: W1
  hdr.ipv4.dst_addr: W0
  hdr.udp.src_port: H13
  hdr.udp.dst_port: TH10
  hdr.udp.len: TH9
  hdr.udp.checksum: H12
  hdr.bth.w0: TW11
  hdr.bth.w1: TW10
  hdr.bth.w2: TW7
  hdr.evid.magic: TB4
  hdr.evid.path_id: B2
  hdr.evid.rtt_q: H10(8..15)
  hdr.evid.loss_q: H10(0..7)
  hdr.evid.ecn_q: TW7(24..31)
  hdr.evid.flags: TW7(16..23)
  hdr.evid.seq: TW7(0..15)
  ig_intr_md_for_dprsr.drop_ctl: {  stage 2..12: B1(5..7) } 
  ig_intr_md_for_dprsr.mirror_type: {  stage 12: B0(0..2) } 
  ig_intr_md_for_tm.ucast_egress_port: {  stage 5..12: H0(0..8) } 
  ig_intr_md_for_tm.qid: {  stage 5..12: B1(0..4) } 
  $tmp2: {  stage 12: H1(0..9) } 
  hdr.ethernet.$valid: H3(0)
  hdr.fabric.$valid: H3(1)
  hdr.csig.$valid: H3(2)
  hdr.ipv4.$valid: H3(3)
  hdr.udp.$valid: H3(4)
  hdr.bth.$valid: H3(5)
  hdr.evid.$valid: H3(6)
  context_json:
    B0:
    - { name : ig_intr_md_for_dprsr.mirror_type, live_start : deparser, live_end : deparser, mutually_exclusive_with: [  ] }
    B1:
    - { name : ig_intr_md_for_dprsr.drop_ctl, live_start : 2, live_end : deparser, mutually_exclusive_with: [  ] }
    - { name : ig_intr_md_for_tm.qid, live_start : 5, live_end : deparser, mutually_exclusive_with: [  ] }
    B2:
    - { name : hdr.evid.path_id, live_start : parser, live_end : deparser, mutually_exclusive_with: [  ] }
    B3:
    - { name : md.attn_idx, live_start : parser, live_end : 5, mutually_exclusive_with: [  ] }
    B4:
    - { name : md.attn_idx, live_start : parser, live_end : 5, mutually_exclusive_with: [  ] }
    B5:
