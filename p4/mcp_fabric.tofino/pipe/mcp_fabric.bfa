parser ingress:
  start: $entry_point.start
  init_zero: [ W6, W7, W8, H8, H5, H6, H7, H10, H37, W9, H15, B3, B6, H12, H1, W4, H38, W5, H39, H41, B1, B0, H2, B9 ]
  bitwise_or: [ B9 ]
  hdr_len_adj: 16
  states:
    $entry_point.start:
      *:
        0..1: H40  # bit[7..15] -> H40 bit[8..0]: ingress::ig_intr_md.ingress_port
        16..17: TH13  # ingress::hdr.ethernet.dst_addr[47:32].32-47
        18..19: TH11  # ingress::hdr.ethernet.dst_addr[31:16].16-31
        20..21: TH10  # ingress::hdr.ethernet.dst_addr[15:0].0-15
        W4: 2779096485  # value 2779096485 -> W4 bit[31..0]: ingress::md.mir_dmac[31:0].0-31
        shift: 22
        buf_req: 22
        next: $entry_point.start.$split_0
    $entry_point.start.$split_0:
      *:
        0..1: TH12  # ingress::hdr.ethernet.src_addr[47:32].32-47
        2..3: TH9  # ingress::hdr.ethernet.src_addr[31:16].16-31
        4..5: TH8  # ingress::hdr.ethernet.src_addr[15:0].0-15
        6..7: H32  # ingress::hdr.ethernet.ether_type
        H38: 42405  # value 42405 -> H38 bit[15..0]: ingress::md.mir_dmac[47:32].32-47
        H39: 512  # value 512 -> H39 bit[15..0]: ingress::md.mir_smac[47:32].32-47
        load: { half : 6..7 }
        shift: 8
        buf_req: 8
        next: $entry_point.start.$split_1
    $entry_point.start.$split_1:
      *:
        W5: 19779  # value 19779 -> W5 bit[31..0]: ingress::md.mir_smac[31:0].0-31
        buf_req: 0
        next: $entry_point.start.$split_2
    $entry_point.start.$split_2:
      match: [ half ]
      0x88f0:
        H41: 35057  # value 35057 -> H41 bit[15..0]: ingress::md.mir_etype
        B9: 1  # value 1 -> B9 bit[0]: ingress::hdr.ethernet.$valid
        buf_req: 0
        next: parse_fabric
      0x0800:
        H41: 35057  # value 35057 -> H41 bit[15..0]: ingress::md.mir_etype
        B9: 1  # value 1 -> B9 bit[0]: ingress::hdr.ethernet.$valid
        buf_req: 0
        next: parse_ipv4
      0x****:
        H41: 35057  # value 35057 -> H41 bit[15..0]: ingress::md.mir_etype
        B9: 1  # value 1 -> B9 bit[0]: ingress::hdr.ethernet.$valid
        buf_req: 0
        next: end
    parse_fabric:
      *:
        0..1: H33  # ingress::hdr.fabric.vsw_id
        0..3: W6  # bit[16..31] -> W6 bit[15..0]: ingress::md.hop
        2..3: H34  # ingress::hdr.fabric.hop
        4..5: H8  # ingress::md.spray_idx
        4..5: H9  # ingress::hdr.fabric.spray
        6: B6  # ingress::md.attn_idx[15:8].8-15
        6: B7  # ingress::hdr.fabric.path_id[15:8].8-15
        7: B3  # ingress::md.attn_idx[7:0].0-7
        7: B4  # ingress::hdr.fabric.path_id[7:0].0-7
        load: { byte1 : 10 }
        shift: 8
        buf_req: 11
        next: parse_fabric.$split_0
    parse_fabric.$split_0:
      match: [ byte1 ]
      0x01:
        0..1: H11
            # - bit[0..7] -> H11 bit[15..8]: ingress::hdr.fabric.loops
            # - bit[8..15] -> H11 bit[7..0]: ingress::hdr.fabric.flags
        2..3: H13
            # - bit[16..23] -> H13 bit[15..8]: ingress::hdr.fabric.nxt
            # - bit[24..31] -> H13 bit[7..0]: ingress::hdr.fabric.pad
        B9: 2  # value 1 -> B9 bit[1]: ingress::hdr.fabric.$valid
        shift: 4
        buf_req: 4
        next: parse_csig
      0x**:
        0..1: H11
