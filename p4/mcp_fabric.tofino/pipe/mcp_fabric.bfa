      - priority: 1
        match_key_fields_values:
        - field_name: md.exceed
          value: "0x1"
        action_handle: 0x20000018
        is_default_entry: false
        action_parameters_values: []

    action_bus: { 1 : tbl_attn_0$salu.Ingress.reg_attn(8..15), 32..33 : tbl_attn_0$salu.Ingress.reg_attn(0..15) }
    stateful: tbl_attn_0$salu.Ingress.reg_attn(hash_dist 0, $DEFAULT, meter_type)
    instruction: tbl_attn_0(action, $DEFAULT)
    actions:
      Ingress.act_attn_exceed(0, 3):
      - hit_allowed: { allowed: true }
      - default_action: { allowed: true }
      - handle: 0x20000018
      - next_table: 0
      - set B5(0..7), tbl_attn_0$salu.Ingress.reg_attn(8..15)
      - set H15(0..7), tbl_attn_0$salu.Ingress.reg_attn(0..7)
      - tbl_attn_0$salu.Ingress.reg_attn(attn_on_exceed_0, $hash_dist)
      Ingress.act_attn_clean(1, 4):
      - hit_allowed: { allowed: true }
      - default_action: { allowed: true }
      - handle: 0x20000019
      - next_table: 0
      - set B5(0..7), tbl_attn_0$salu.Ingress.reg_attn(8..15)
      - set H15(0..7), tbl_attn_0$salu.Ingress.reg_attn(0..7)
      - tbl_attn_0$salu.Ingress.reg_attn(attn_on_clean_0, $hash_dist)
