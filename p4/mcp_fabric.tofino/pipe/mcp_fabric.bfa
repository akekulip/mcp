    H0:
    - { name : ig_intr_md_for_tm.ucast_egress_port, live_start : 5, live_end : deparser, mutually_exclusive_with: [  ] }
    H1:
    - { name : $tmp2, live_start : deparser, live_end : deparser, mutually_exclusive_with: [  ] }
    H2:
    - { name : hdr.fabric.flags, live_start : parser, live_end : deparser, mutually_exclusive_with: [  ] }
    - { name : hdr.fabric.nxt, live_start : parser, live_end : deparser, mutually_exclusive_with: [  ] }
    H3:
