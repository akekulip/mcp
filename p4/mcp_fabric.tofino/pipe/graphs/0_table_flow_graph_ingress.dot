 md.attn_idx\l
 ig_intr_md_for_tm.ucast_egress_port\l
 ig_intr_md_for_tm.qid\l
 ig_intr_md_for_dprsr.drop_ctl\l
 "];
cond_15 [ shape=record, style="filled", fillcolor=cornsilk, label="md.hop != 2 || hdr.evid.$valid == 1\l\l
 "];
tbl_fail_0 [ shape=record, style="filled", fillcolor=cornsilk, label="tbl_fail_0\l\l
M:\l
 md.vlink_id\l
 md.rnd_fail\l
\lW:\l
 ig_intr_md_for_dprsr.drop_ctl\l
 ig_intr_md_for_dprsr.mirror_type\l
 md.mirror_sid\l
 md.flags_out\l
 hdr.udp.checksum\l
 "];
tbl_attn_0 [ shape=record, style="filled", fillcolor=cornsilk, label="tbl_attn_0\l\l
M:\l
 md.exceed\l
\lW:\l
 md.attn\l
 "];
cond_16 [ shape=record, style="filled", fillcolor=cornsilk, label="hdr.evid.$valid == 1\l\l
 "];
tbl_gate_0 [ shape=record, style="filled", fillcolor=cornsilk, label="tbl_gate_0\l\l
M:\l
 md.attn\l
