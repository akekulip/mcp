\lW:\l
 md.role\l
 md.src_leaf\l
 "];
cond_10 [ shape=record, style="filled", fillcolor=cornsilk, label="md.role == 1 && hdr.fabric.$valid == 1\l\l
 "];
tbl_mcp_fabric761 [ shape=record, style="filled", fillcolor=cornsilk, label="tbl_mcp_fabric761\l\l
