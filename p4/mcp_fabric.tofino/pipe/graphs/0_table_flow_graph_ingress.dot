 "];
tbl_final_0 [ shape=record, style="filled", fillcolor=cornsilk, label="tbl_final_0\l\l
M:\l
 md.role\l
 md.hop\l
 md.dst_leaf\l
\lR:\l
 md.next_vsw\l
 md.spray_idx\l
 md.flags_out\l
 md.attn_idx\l
\lW:\l
 hdr.fabric.$valid\l
 hdr.fabric.vsw_id\l
 hdr.fabric.hop\l
 hdr.fabric.spray\l
 hdr.fabric.loops\l
 hdr.fabric.flags\l
