    tbl_mcp_fabric779 -> tbl_spray_sel_0
    tbl_spray_sel_0 -> tbl_spray_mode_0
    tbl_spray_mode_0 -> cond_12
    cond_12 -> tbl_exceed_evid_0
    cond_12 -> cond_13
    tbl_exceed_evid_0 -> cond_14
    cond_13 -> tbl_exceed_csig_0
    cond_13 -> cond_14
    tbl_exceed_csig_0 -> cond_14
    cond_14 -> tbl_vlink_0
    cond_14 -> cond_15
    tbl_vlink_0 -> tbl_fail_0
    tbl_fail_0 -> cond_15
    cond_15 -> tbl_attn_0
    cond_15 -> cond_16
    tbl_attn_0 -> tbl_gate_0
    tbl_gate_0 -> cond_16
    cond_16 -> tbl_evid_fwd_0
    cond_16 -> tbl_final_0
    tbl_evid_fwd_0 -> DEPARSER
    tbl_final_0 -> DEPARSER
}
