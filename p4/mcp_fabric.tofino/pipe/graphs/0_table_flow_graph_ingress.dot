 hdr.ipv4.dst_addr\l
\lW:\l
 md.dst_leaf\l
 "];
tbl_mcp_fabric768 [ shape=record, style="filled", fillcolor=cornsilk, label="tbl_mcp_fabric768\l\l
W:\l
 md.rnd_fail\l
 "];
tbl_mcp_fabric769 [ shape=record, style="filled", fillcolor=cornsilk, label="tbl_mcp_fabric769\l\l
W:\l
