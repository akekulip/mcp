digraph ingress {
tbl_port_role_0 [ shape=record, style="filled", fillcolor=cornsilk, label="tbl_port_role_0\l\l
M:\l
 ig_intr_md.ingress_port\l
\lW:\l
 md.role\l
 md.src_leaf\l
 "];
cond_4 [ shape=record, style="filled", fillcolor=cornsilk, label="md.role == 1 && hdr.fabric.$valid == 1\l\l
 "];
tbl_mcp_fabric533 [ shape=record, style="filled", fillcolor=cornsilk, label="tbl_mcp_fabric533\l\l
W:\l
 ig_intr_md_for_dprsr.drop_ctl\l
 "];
tbl_dst_leaf_0 [ shape=record, style="filled", fillcolor=cornsilk, label="tbl_dst_leaf_0\l\l
M:\l
 hdr.ipv4.dst_addr\l
\lW:\l
 md.dst_leaf\l
 "];
tbl_mcp_fabric540 [ shape=record, style="filled", fillcolor=cornsilk, label="tbl_mcp_fabric540\l\l
W:\l
 md.rnd_fail\l
 "];
cond_5 [ shape=record, style="filled", fillcolor=cornsilk, label="md.hop == 0\l\l
 "];
tbl_mcp_fabric546 [ shape=record, style="filled", fillcolor=cornsilk, label="tbl_mcp_fabric546\l\l
W:\l
 md.spray_rand\l
 md.spray_hash\l
 "];
cond_6 [ shape=record, style="filled", fillcolor=cornsilk, label="md.hop != 2\l\l
 "];
tbl_mcp_fabric550 [ shape=record, style="filled", fillcolor=cornsilk, label="tbl_mcp_fabric550\l\l
W:\l
 md.spray_rr\l
 "];
tbl_spray_sel_0 [ shape=record, style="filled", fillcolor=cornsilk, label="tbl_spray_sel_0\l\l
M:\l
 md.src_leaf\l
 md.spray_hash\l
\lW:\l
 md.spray_sel\l
 "];
tbl_spray_mode_0 [ shape=record, style="filled", fillcolor=cornsilk, label="tbl_spray_mode_0\l\l
M:\l
 md.role\l
 md.hop\l
\lR:\l
 md.spray_rand\l
 md.spray_hash\l
 md.spray_rr\l
 md.spray_sel\l
\lW:\l
 md.spray_idx\l
 "];
tbl_vlink_0 [ shape=record, style="filled", fillcolor=cornsilk, label="tbl_vlink_0\l\l
M:\l
 md.role\l
 md.hop\l
 md.src_leaf\l
 md.dst_leaf\l
 md.spray_idx\l
\lW:\l
 md.vlink_id\l
 md.next_vsw\l
 ig_intr_md_for_tm.ucast_egress_port\l
 ig_intr_md_for_tm.qid\l
 ig_intr_md_for_dprsr.drop_ctl\l
 "];
tbl_final_0 [ shape=record, style="filled", fillcolor=cornsilk, label="tbl_final_0\l\l
M:\l
 md.role\l
 md.hop\l
 md.dst_leaf\l
\lR:\l
 md.next_vsw\l
 md.spray_idx\l
 md.fault\l
\lW:\l
 hdr.fabric.$valid\l
 hdr.fabric.vsw_id\l
 hdr.fabric.hop\l
 hdr.fabric.spray\l
 hdr.fabric.loops\l
 hdr.fabric.flags\l
 hdr.fabric.nxt\l
 hdr.ethernet.ether_type\l
 hdr.csig.$valid\l
 ig_intr_md_for_tm.ucast_egress_port\l
 ig_intr_md_for_tm.qid\l
 ig_intr_md_for_dprsr.drop_ctl\l
 "];
tbl_fail_0 [ shape=record, style="filled", fillcolor=cornsilk, label="tbl_fail_0\l\l
M:\l
 md.vlink_id\l
 md.rnd_fail\l
\lW:\l
 ig_intr_md_for_dprsr.drop_ctl\l
 md.fault\l
 hdr.udp.checksum\l
 "];
    PARSER -> tbl_port_role_0
    tbl_port_role_0 -> cond_4
    cond_4 -> tbl_mcp_fabric533
    cond_4 -> tbl_dst_leaf_0
    tbl_mcp_fabric533 -> DEPARSER
    tbl_dst_leaf_0 -> tbl_mcp_fabric540
    tbl_mcp_fabric540 -> cond_5
    cond_5 -> tbl_mcp_fabric546
    cond_5 -> cond_6
    tbl_mcp_fabric546 -> tbl_mcp_fabric550
    tbl_mcp_fabric550 -> tbl_spray_sel_0
    tbl_spray_sel_0 -> tbl_spray_mode_0
    tbl_spray_mode_0 -> cond_6
    cond_6 -> tbl_vlink_0
    cond_6 -> tbl_final_0
    tbl_vlink_0 -> tbl_fail_0
    tbl_fail_0 -> tbl_final_0
    tbl_final_0 -> DEPARSER
}
