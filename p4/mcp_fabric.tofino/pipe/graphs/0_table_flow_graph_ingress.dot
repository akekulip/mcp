M:\l
 md.src_leaf\l
 md.spray_hash\l
\lW:\l
 md.spray_sel\l
 "];
tbl_spray_mode_0 [ shape=record, style="filled", fillcolor=cornsilk, label="tbl_spray_mode_0\l\l
M:\l
 md.role\l
 md.hop\l
\lR:\l
 md.spray_rand\l
 md.spray_hash\l
 md.spray_rr\l
 md.spray_sel\l
\lW:\l
 md.spray_idx\l
 "];
tbl_exceed_evid_0 [ shape=record, style="filled", fillcolor=cornsilk, label="tbl_exceed_evid_0\l\l
M:\l
 hdr.evid.loss_q\l
 hdr.evid.rtt_q\l
\lR:\l
 hdr.evid.path_id\l
\lW:\l
 md.exceed\l
 md.attn_idx\l
 "];
cond_13 [ shape=record, style="filled", fillcolor=cornsilk, label="hdr.csig.$valid == 1\l\l
 "];
cond_14 [ shape=record, style="filled", fillcolor=cornsilk, label="md.hop != 2 && !(hdr.evid.$valid == 1)\l\l
 "];
tbl_exceed_csig_0 [ shape=record, style="filled", fillcolor=cornsilk, label="tbl_exceed_csig_0\l\l
M:\l
 hdr.csig.worst_qdepth\l
\lW:\l
 md.exceed\l
 "];
tbl_vlink_0 [ shape=record, style="filled", fillcolor=cornsilk, label="tbl_vlink_0\l\l
M:\l
 md.role\l
 md.hop\l
 md.src_leaf\l
 md.dst_leaf\l
 md.spray_idx\l
\lW:\l
