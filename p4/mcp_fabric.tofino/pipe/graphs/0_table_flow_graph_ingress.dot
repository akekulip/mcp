 ig_intr_md_for_tm.ucast_egress_port\l
 ig_intr_md_for_tm.qid\l
 ig_intr_md_for_dprsr.drop_ctl\l
 "];
    PARSER -> tbl_port_role_0
    tbl_port_role_0 -> cond_10
    cond_10 -> tbl_mcp_fabric761
    cond_10 -> tbl_dst_leaf_0
    tbl_mcp_fabric761 -> DEPARSER
    tbl_dst_leaf_0 -> tbl_mcp_fabric768
    tbl_mcp_fabric768 -> tbl_mcp_fabric769
